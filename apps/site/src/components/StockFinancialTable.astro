---
import type { Statement } from "../lib/db";

interface Props {
  title: string;
  companyName: string;
  statement: Statement;
  emptyMessage: string;
  investorRows: string[];
  initialPeriods: number;
  expandedPeriods: number;
}

const { title, companyName, statement, emptyMessage, investorRows, initialPeriods, expandedPeriods } = Astro.props;
// Statement data is normalized oldest → newest. Keep that same reading
// direction everywhere so the latest quarter/year is always at the right edge.
const periods = statement.periods;
const explanations: Record<string, string> = {
  revenue: "The money the company earned from customers before subtracting costs.",
  sales: "The money the company earned from customers before subtracting costs.",
  "cost of revenue": "The direct cost of producing the goods or services sold during the period.",
  "gross profit": "Revenue left after direct production costs; it shows the basic economics of what the company sells.",
  "operating income": "Profit from the core business before interest and taxes.",
  "net income": "Profit remaining for shareholders after all expenses and taxes.",
  "earnings per share": "Profit attributable to each diluted share, useful for comparing growth on a per-share basis.",
  "diluted eps": "Profit attributable to each share after accounting for options and other potential shares.",
  "total assets": "Everything the company controls that has economic value at the reporting date.",
  "total liabilities": "All obligations the company owes at the reporting date.",
  "stockholders equity": "The accounting value left for shareholders after subtracting liabilities from assets.",
  "shareholders equity": "The accounting value left for shareholders after subtracting liabilities from assets.",
  "cash and cash equivalents": "Cash and highly liquid holdings available to meet near-term needs.",
  "accounts receivable": "Money customers owe the company for sales already recorded.",
  inventory: "Goods and materials held for sale or production.",
  "accounts payable": "Money the company owes suppliers for purchases already received.",
  "operating cash flow": "Cash generated by the company's normal operations.",
  "cash flow from operating activities": "Cash generated by the company's normal operations.",
  "capital expenditures": "Cash spent on long-lived assets needed to maintain or grow the business.",
  "free cash flow": "Cash left from operations after capital spending, available for debt reduction or shareholder returns.",
  depreciation: "A non-cash expense that spreads the cost of long-lived assets over their useful lives.",
  "stock based compensation": "Employee compensation paid with shares or options, which can dilute existing owners.",
};
const normalized = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
const isInvestorRow = (label: string) => investorRows.some((row) => normalized(label).includes(normalized(row)));
const explanationFor = (label: string) => Object.entries(explanations).find(([key]) => normalized(label).includes(normalized(key)))?.[1]
  ?? `${label} is a standardized line from the company's financial statement. Compare it across periods to understand direction and consistency.`;
const isPrimary = (label: string) => /revenue|sales|operating income|net income|total assets|total debt|operating (activities|cash flow)|free cash flow/i.test(label);
const formatAmount = (value: string | null): string => {
  if (value === null) return "—";
  const number = Number(value);
  if (!Number.isFinite(number)) return "—";
  const absolute = Math.abs(number);
  const scaled = absolute >= 1e9 ? `${(absolute / 1e9).toFixed(1)}B` : absolute >= 1e6 ? `${(absolute / 1e6).toFixed(1)}M` : absolute.toLocaleString("en-US", { maximumFractionDigits: 2 });
  return number < 0 ? `(${scaled})` : scaled;
};
---

{periods.length > 0 && statement.lines.length > 0 ? (
  <div class="financial-table-shell" data-financial-table data-initial-periods={initialPeriods} data-period-total={periods.length}>
    <div class="financial-controls">
      <div class="view-switch" role="group" aria-label={`${title} detail level`}>
        <button type="button" data-financial-view="investor" aria-pressed="true">Investor View</button>
        <button type="button" data-financial-view="detailed" aria-pressed="false">Detailed View</button>
      </div>
      <div class="history-switch" role="group" aria-label={`${title} history`}>
        <button type="button" data-period-count={initialPeriods} aria-pressed="true">{initialPeriods} periods</button>
        {periods.length > initialPeriods && <button type="button" data-period-count={expandedPeriods} aria-pressed="false">{expandedPeriods} periods</button>}
        {periods.length > expandedPeriods && <button type="button" data-period-count="all" aria-pressed="false">Max</button>}
      </div>
    </div>
    <div class="statement-scroll" tabindex="0" role="group" aria-label={`${title} for ${companyName}; previous periods lead to the latest period on the right`}>
      <table class="financial-table">
        <caption class="sr-only">{title} for {companyName}; values in auto-scaled US dollars, ordered from previous periods to latest.</caption>
        <thead><tr><th scope="col">Metric</th>{periods.map((period, index) => <th scope="col" data-period-index={index} title={`Period ended ${period.period_end}`}><span>{period.fiscal_period} {period.fiscal_year}</span><small>{period.period_end}</small></th>)}</tr></thead>
        <tbody>{statement.lines.map((line) => {
          const investor = isInvestorRow(line.label);
          return <tr data-investor-row={investor ? "true" : "false"} class:list={[isPrimary(line.label) && "primary-financial-row"]}>
            <th scope="row"><span>{line.label}</span>{investor && <button class="metric-explainer-button" type="button" aria-label={`Explain ${line.label}`} data-metric-label={line.label} data-metric-explanation={explanationFor(line.label)}>?</button>}</th>
            {line.values.map((value, index) => <td data-period-index={index}>{formatAmount(value)}</td>)}
          </tr>;
        })}</tbody>
      </table>
    </div>
    <p class="financial-empty-filter" hidden>No Investor View rows are available. Use Detailed View to see the complete normalized statement.</p>
  </div>
) : <p class="data-empty">{emptyMessage}</p>}
