---
// Shared metric-grid renderer (design framework Sec 11.3/12.2/17.2/20.2).
// Used for both the curated "Key metrics" set and every category group in
// "All metrics" -- one place owns the null-state contract instead of it
// being re-implemented per section, which is how the previous version of
// this page drifted (a "—" that was only ever explained via `title`,
// invisible to keyboard and screen-reader users).
//
// Null-state accessibility rule (framework Sec 17.2, "a dash must not be
// the only accessible label for a missing value"): every blocked cell
// gets BOTH a hover `title` (mouse users) AND an `aria-label` naming the
// metric and the specific reason (keyboard/screen-reader/touch users --
// `title` alone reaches none of those).
import type { MetricRow } from "../lib/db";
import { fmtPct, fmtNum, fmtMultiple, fmtDays, fmtScore, fmtBool, fmtYears } from "../lib/format";

export type MetricKind = "pct" | "dollar" | "multiple" | "raw" | "days" | "score" | "bool" | "years";

export interface MetricItem {
  label: string;
  row?: MetricRow;
  kind: MetricKind;
  raw?: string;
  rawTitle?: string;
  nullReason?: string;
}

interface Props {
  items: MetricItem[];
  dense?: boolean;
}

const { items, dense = false } = Astro.props;

function formatValue(item: MetricItem): string {
  const value = item.kind === "raw" ? item.raw : item.row?.value;
  switch (item.kind) {
    case "dollar":
      return value ? "$" + fmtNum(value) : "—";
    case "multiple":
      return fmtMultiple(value);
    case "days":
      return fmtDays(value);
    case "score":
      return fmtScore(value);
    case "bool":
      return fmtBool(value);
    case "years":
      return fmtYears(value);
    case "raw":
      return value ?? "—";
    default:
      return fmtPct(value);
  }
}
---

<div class={`metric-grid${dense ? " metric-grid-dense" : ""}`}>
  {items.map((item) => {
    const isNull = item.kind === "raw" ? !item.raw : item.row?.value == null;
    const reason = item.kind === "raw"
      ? (item.nullReason ?? "Not available for this company")
      : item.row?.is_null_reason
        ? `Not computed for the latest period: ${item.row.is_null_reason}`
        : "Not yet resolved for this company";
    const period = item.kind !== "raw" && item.row && !isNull ? `${item.row.period_label} · ${item.row.period_end}` : null;
    const valueTitle = item.kind === "raw" ? item.rawTitle : period ?? undefined;
    return (
      <div class="metric-cell">
        <span class="metric-label">{item.label}</span>
        {isNull ? (
          <span class="metric-value metric-blocked" title={reason} aria-label={`${item.label}: not available. ${reason}`}>—</span>
        ) : (
          <span class="metric-value" title={valueTitle} aria-label={period ? `${item.label}: ${formatValue(item)}, ${period}` : undefined}>{formatValue(item)}</span>
        )}
        {!dense && period && <span class="metric-period">{period}</span>}
      </div>
    );
  })}
</div>

<style>
  /* "Metric ledger" pattern -- design guideline Sec 11: a grid of
     hairline-divided cells, not a shelf of shadowed widgets. Value leads
     in mono; label recedes in small caps.

     Fixed column counts, not auto-fill: the guideline's own demo grid
     (4 hardcoded items) uses repeat(4,1fr) and never hits this, but a
     real category can have any item count (1-8). auto-fill combined
     with a parent background-as-gap-color trick left the LAST
     incomplete row's unfilled grid tracks showing the parent's raw
     background as a big empty tan box -- found live, "All Metrics" on
     the company page, several categories. Fixed by giving every actual
     cell its own right/bottom border instead of relying on the parent
     background bleeding through gaps -- this is correct for any item
     count against any column count, incomplete last row or not. */
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border-strong, #c9c2ac);
    border-left: 1px solid var(--border-strong, #c9c2ac);
  }
  .metric-cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    background: var(--surface-primary, #fff);
    padding: 16px 18px;
    border-right: 1px solid var(--border-default, #e7e2d6);
    border-bottom: 1px solid var(--border-default, #e7e2d6);
  }
  .metric-grid-dense .metric-cell {
    padding: 13px 16px;
  }
  @media (max-width: 640px) {
    .metric-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .metric-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-secondary);
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .metric-value {
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }
  .metric-grid-dense .metric-value {
    font-size: 16px;
  }
  .metric-value.metric-blocked {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 14px;
    font-family: var(--sans, sans-serif);
    cursor: help;
  }
  .metric-period {
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 10.5px;
    color: var(--text-muted);
  }
</style>
