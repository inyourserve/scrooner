---
interface Props {
  id: string;
  variant?: "header" | "hero";
  label?: string;
  placeholder?: string;
}

const {
  id,
  variant = "header",
  label = "Search for a company or ticker",
  placeholder = variant === "header" ? "Search companies" : "Company or ticker",
} = Astro.props;
const listboxId = `${id}-options`;
const messageId = `${id}-message`;
---

<form
  class:list={["company-finder", `company-finder--${variant}`]}
  data-company-search
  data-global-company-search={variant === "header" ? "true" : undefined}
  data-endpoint="/api/company-search.json"
  role="search"
  novalidate
>
  <label class="sr-only" for={id}>{label}</label>
  <div class="company-finder-control">
    <svg class="company-finder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M21 21l-4.3-4.3"></path>
    </svg>
    <input
      id={id}
      name="company"
      type="search"
      placeholder={placeholder}
      autocomplete="off"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={listboxId}
      aria-describedby={messageId}
    />
  </div>

  <div class="company-finder-panel" data-search-panel hidden>
    <div class="company-finder-panel-heading" data-panel-heading>
      <span data-panel-title>Companies</span>
      <button type="button" data-clear-recent hidden>Clear recent</button>
    </div>
    <ul id={listboxId} role="listbox" aria-label="Company suggestions" data-search-list></ul>
    <p class="company-finder-empty" data-search-empty hidden></p>
  </div>
  <p class="company-finder-message sr-only" id={messageId} role="status" aria-live="polite" data-search-message></p>
</form>

<script>
  import {
    addRecentCompany,
    isSearchCompany,
    normalizeCompanyQuery,
    normalizeRecentCompanies,
    type SearchCompany,
  } from "../lib/companySearch";

  const RECENT_STORAGE_KEY = "scrooner.recent-companies.v1";
  const MAX_CACHED_SEARCHES = 30;
  const requestCache = new Map<string, Promise<SearchCompany[]>>();

  function loadRecentCompanies(): SearchCompany[] {
    try {
      return normalizeRecentCompanies(JSON.parse(localStorage.getItem(RECENT_STORAGE_KEY) ?? "[]"));
    } catch {
      return [];
    }
  }

  function storeRecentCompanies(companies: SearchCompany[]): void {
    try {
      localStorage.setItem(RECENT_STORAGE_KEY, JSON.stringify(companies));
    } catch {
      // Search remains fully functional when storage is disabled.
    }
  }

  function companyUrl(company: SearchCompany): string {
    return `/stock/${encodeURIComponent(company.ticker.toLowerCase())}/`;
  }

  function fetchCompanies(endpoint: string, query: string): Promise<SearchCompany[]> {
    const normalized = normalizeCompanyQuery(query);
    const cached = requestCache.get(normalized);
    if (cached) return cached;

    const request = fetch(`${endpoint}?q=${encodeURIComponent(normalized)}`, {
      headers: { Accept: "application/json" },
    })
      .then(async (response) => {
        if (!response.ok) throw new Error("Company search request failed");
        const body: unknown = await response.json();
        if (!body || typeof body !== "object" || !("companies" in body)) return [];
        const companies = (body as { companies: unknown }).companies;
        return Array.isArray(companies) ? companies.filter(isSearchCompany) : [];
      })
      .catch((error) => {
        requestCache.delete(normalized);
        throw error;
      });
    requestCache.set(normalized, request);
    if (requestCache.size > MAX_CACHED_SEARCHES) {
      const oldest = requestCache.keys().next().value;
      if (oldest) requestCache.delete(oldest);
    }
    return request;
  }

  document.querySelectorAll<HTMLElement>("[data-company-search]").forEach((root) => {
    if (root.dataset.searchReady === "true") return;
    root.dataset.searchReady = "true";

    const form = root as HTMLFormElement;
    const input = root.querySelector<HTMLInputElement>("[role='combobox']");
    const panel = root.querySelector<HTMLElement>("[data-search-panel]");
    const list = root.querySelector<HTMLUListElement>("[data-search-list]");
    const empty = root.querySelector<HTMLElement>("[data-search-empty]");
    const message = root.querySelector<HTMLElement>("[data-search-message]");
    const panelTitle = root.querySelector<HTMLElement>("[data-panel-title]");
    const clearRecent = root.querySelector<HTMLButtonElement>("[data-clear-recent]");
    const endpoint = root.dataset.endpoint ?? "/api/company-search.json";
    if (!input || !panel || !list || !empty || !message || !panelTitle || !clearRecent) return;

    let recent = loadRecentCompanies();
    let visibleCompanies: SearchCompany[] = [];
    let activeIndex = -1;
    let debounceTimer: number | undefined;
    let requestSequence = 0;

    const closePanel = () => {
      panel.hidden = true;
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      activeIndex = -1;
    };

    const openPanel = () => {
      panel.hidden = false;
      input.setAttribute("aria-expanded", "true");
    };

    const setActiveIndex = (nextIndex: number) => {
      if (visibleCompanies.length === 0) return;
      activeIndex = (nextIndex + visibleCompanies.length) % visibleCompanies.length;
      list.querySelectorAll<HTMLElement>("[role='option']").forEach((option, index) => {
        const selected = index === activeIndex;
        option.setAttribute("aria-selected", String(selected));
        option.classList.toggle("is-active", selected);
        if (selected) {
          input.setAttribute("aria-activedescendant", option.id);
          option.scrollIntoView({ block: "nearest" });
        }
      });
    };

    const selectCompany = (company: SearchCompany) => {
      recent = addRecentCompany(recent, company);
      storeRecentCompanies(recent);
      window.location.assign(companyUrl(company));
    };

    const renderCompanies = (companies: SearchCompany[], recentMode = false) => {
      visibleCompanies = companies;
      activeIndex = -1;
      input.removeAttribute("aria-activedescendant");
      list.replaceChildren();
      empty.hidden = true;
      panelTitle.textContent = recentMode ? "Recent companies" : "Companies";
      clearRecent.hidden = !recentMode || companies.length === 0;

      companies.forEach((company, index) => {
        const option = document.createElement("li");
        option.id = `${input.id}-option-${index}`;
        option.className = "company-finder-option";
        option.setAttribute("role", "option");
        option.setAttribute("aria-selected", "false");

        const ticker = document.createElement("span");
        ticker.className = "company-finder-ticker";
        ticker.textContent = company.ticker;
        const identity = document.createElement("span");
        identity.className = "company-finder-identity";
        const name = document.createElement("strong");
        name.textContent = company.company_name;
        const detail = document.createElement("span");
        detail.textContent = [company.exchange, company.sector].filter(Boolean).join(" · ") || "Current listing";
        identity.append(name, detail);
        option.append(ticker, identity);

        option.addEventListener("pointermove", () => setActiveIndex(index));
        option.addEventListener("pointerdown", (event) => {
          event.preventDefault();
          selectCompany(company);
        });
        list.append(option);
      });

      if (companies.length > 0) openPanel();
      else closePanel();
    };

    const showEmpty = (text: string, announcement = text) => {
      visibleCompanies = [];
      list.replaceChildren();
      panelTitle.textContent = "Companies";
      clearRecent.hidden = true;
      empty.textContent = text;
      empty.hidden = false;
      message.textContent = announcement;
      openPanel();
    };

    const showRecent = () => {
      recent = loadRecentCompanies();
      if (recent.length > 0) {
        renderCompanies(recent, true);
        message.textContent = `${recent.length} recent ${recent.length === 1 ? "company" : "companies"}.`;
      } else {
        closePanel();
      }
    };

    const runSearch = async (query: string): Promise<SearchCompany[]> => {
      const normalized = normalizeCompanyQuery(query);
      if (!normalized) {
        showRecent();
        return [];
      }

      const sequence = ++requestSequence;
      showEmpty("Searching companies…", "Searching companies.");
      try {
        const companies = await fetchCompanies(endpoint, normalized);
        if (sequence !== requestSequence || normalizeCompanyQuery(input.value) !== normalized) return [];
        if (companies.length === 0) {
          showEmpty("No covered company matches that search.");
          return [];
        }
        renderCompanies(companies);
        message.textContent = `${companies.length} ${companies.length === 1 ? "company" : "companies"} found. Use arrow keys to review.`;
        return companies;
      } catch {
        if (sequence === requestSequence) showEmpty("Company search is temporarily unavailable. Try again.");
        return [];
      }
    };

    input.addEventListener("focus", () => {
      if (normalizeCompanyQuery(input.value)) void runSearch(input.value);
      else showRecent();
    });

    input.addEventListener("input", () => {
      message.textContent = "";
      window.clearTimeout(debounceTimer);
      if (!normalizeCompanyQuery(input.value)) {
        requestSequence += 1;
        showRecent();
        return;
      }
      debounceTimer = window.setTimeout(() => void runSearch(input.value), 160);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        if (panel.hidden) {
          if (normalizeCompanyQuery(input.value)) void runSearch(input.value);
          else showRecent();
        }
        setActiveIndex(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActiveIndex(activeIndex - 1);
      } else if (event.key === "Enter" && activeIndex >= 0) {
        event.preventDefault();
        selectCompany(visibleCompanies[activeIndex]);
      } else if (event.key === "Escape") {
        event.preventDefault();
        closePanel();
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (activeIndex >= 0 && visibleCompanies[activeIndex]) {
        selectCompany(visibleCompanies[activeIndex]);
        return;
      }
      const query = normalizeCompanyQuery(input.value);
      if (!query) {
        message.textContent = "Enter a company name or ticker.";
        input.focus();
        return;
      }
      const companies = await runSearch(query);
      const exact = companies.find(
        (company) => company.ticker.toLowerCase() === query || company.company_name.toLowerCase() === query,
      );
      const match = exact ?? companies[0];
      if (match) selectCompany(match);
    });

    clearRecent.addEventListener("pointerdown", (event) => event.preventDefault());
    clearRecent.addEventListener("click", () => {
      recent = [];
      storeRecentCompanies([]);
      closePanel();
      message.textContent = "Recent companies cleared.";
      input.focus();
    });

    document.addEventListener("pointerdown", (event) => {
      if (!root.contains(event.target as Node)) closePanel();
    });
  });

  if (document.documentElement.dataset.companySearchShortcut !== "ready") {
    document.documentElement.dataset.companySearchShortcut = "ready";
    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      const isEditing = target?.matches("input, textarea, select, [contenteditable='true']");
      if (event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey && !isEditing) {
        const globalInput = document.querySelector<HTMLInputElement>("[data-global-company-search] [role='combobox']");
        if (globalInput) {
          event.preventDefault();
          globalInput.focus();
        }
      }
    });
  }
</script>

<style is:global>
  .company-finder { position: relative; }
  .company-finder-control {
    display: flex;
    align-items: center;
    gap: var(--ds-space-2);
    border: 1px solid var(--ds-color-border-default);
    background: var(--ds-color-bg-surface);
    transition: border-color var(--ds-duration-fast) var(--ds-ease-standard), box-shadow var(--ds-duration-fast) var(--ds-ease-standard);
  }
  .company-finder-control:focus-within {
    border-color: var(--ds-color-action);
    box-shadow: 0 0 0 4px var(--ds-color-action-subtle);
  }
  .company-finder-icon { flex: none; color: var(--ds-color-text-muted); }
  .company-finder input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ds-color-text-primary);
  }
  .company-finder input::placeholder { color: var(--ds-color-text-muted); }
  .company-finder--header { width: min(300px, 25vw); margin-left: auto; }
  .company-finder--header .company-finder-control { min-height: 40px; padding: 4px 12px; border-radius: var(--ds-radius-md); }
  .company-finder--header .company-finder-icon { width: 17px; height: 17px; }
  .company-finder--header input { font-size: var(--ds-font-size-13); }
  .company-finder--hero { width: min(720px, 100%); }
  .company-finder--hero .company-finder-control { min-height: 60px; padding: 10px 18px; gap: var(--ds-space-3); border-width: 1px; border-radius: var(--ds-radius-lg); box-shadow: var(--ds-shadow-surface); }
  .company-finder--hero .company-finder-control:focus-within { box-shadow: 0 0 0 4px var(--ds-color-action-subtle), var(--ds-shadow-surface); }
  .company-finder--hero .company-finder-icon { width: 22px; height: 22px; }
  .company-finder--hero input { font-size: var(--ds-font-size-16); }
  .company-finder-panel {
    position: absolute;
    z-index: 60;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    overflow: hidden;
    border: 1px solid var(--ds-color-border-default);
    border-radius: var(--ds-radius-card);
    background: var(--ds-color-bg-surface);
    box-shadow: var(--ds-shadow-popover);
    text-align: left;
  }
  .company-finder--hero .company-finder-panel {
    position: relative;
    top: auto;
    margin-top: var(--ds-space-2);
  }
  .company-finder-panel-heading {
    min-height: 34px;
    padding: 8px 12px 5px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--ds-color-text-muted);
    font-size: var(--ds-font-size-11);
    font-weight: var(--ds-font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .company-finder-panel-heading button {
    border: 0;
    background: transparent;
    color: var(--ds-color-link);
    font: inherit;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
  }
  .company-finder-panel ul { max-height: min(440px, 60vh); margin: 0; padding: 0 6px 6px; overflow-y: auto; list-style: none; }
  .company-finder-option {
    padding: 10px;
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    border-radius: var(--ds-radius-md);
    cursor: pointer;
  }
  .company-finder-option.is-active { background: var(--ds-color-action-subtle); }
  .company-finder-ticker { color: var(--ds-color-action-hover); font-family: var(--ds-font-family-mono); font-size: var(--ds-font-size-12); font-weight: var(--ds-font-weight-semibold); }
  .company-finder-identity { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .company-finder-identity strong { overflow: hidden; color: var(--ds-color-text-primary); font-size: var(--ds-font-size-13); font-weight: var(--ds-font-weight-medium); text-overflow: ellipsis; white-space: nowrap; }
  .company-finder-identity span { overflow: hidden; color: var(--ds-color-text-muted); font-size: var(--ds-font-size-11); text-overflow: ellipsis; white-space: nowrap; }
  .company-finder-empty { margin: 0; padding: 12px 14px 16px; color: var(--ds-color-text-secondary); font-size: var(--ds-font-size-13); }

  @media (max-width: 1000px) {
    .company-finder--header { width: min(300px, 32vw); }
  }
  @media (max-width: 760px) {
    .company-finder--header { order: 3; width: 100%; margin-left: 0; }
    .company-finder--header .company-finder-control { width: 100%; }
    .company-finder--hero .company-finder-control { padding-left: var(--ds-space-4); }
  }
</style>
