---
interface Props {
  screenerUrl: string;
  current?: "home" | "company" | "methodology" | "data-sources" | "about" | "pricing" | "privacy" | "terms" | "design-system";
  companyHref?: string;
  skipHref: string;
  skipLabel: string;
}

const {
  screenerUrl,
  current = "home",
  companyHref = "/#company-search",
  skipHref,
  skipLabel,
} = Astro.props;
import BrandMark from "./BrandMark.astro";
import CompanySearch from "./CompanySearch.astro";
---

<a class="public-skip-link" href={skipHref}>{skipLabel}</a>
<header class="public-header">
  <nav class="public-nav" aria-label="Primary navigation">
    <a href="/" class="public-brand" aria-label="Scrooner home">
      <BrandMark />
      <span class="brand-name">scrooner</span>
    </a>
    <div class="public-links">
      {current === "home" ? <span aria-current="page">Home</span> : <a href="/">Home</a>}
      {current === "company" ? <span aria-current="page">Company research</span> : <a href={companyHref}>Company research</a>}
      {current === "methodology" ? <span aria-current="page">Methodology</span> : <a href="/methodology/">Methodology</a>}
      {current === "data-sources" ? <span aria-current="page">Data sources</span> : <a href="/data-sources/">Data sources</a>}
      <a href={screenerUrl}>Screener</a>
    </div>
    <CompanySearch id="global-company-search" variant="header" />
    <a class="ds-button ds-button--primary ds-button--small open-screener" href={screenerUrl}>Open screener</a>
  </nav>
</header>

<style>
  .public-skip-link {
    position: fixed;
    top: 10px;
    left: 12px;
    z-index: 100;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--ds-color-text-primary);
    color: var(--ds-color-text-inverse);
    font-size: 13px;
    text-decoration: none;
    transform: translateY(-160%);
  }
  .public-skip-link:focus { transform: translateY(0); }
  .public-header { flex: none; }
  .public-nav {
    min-height: 72px;
    padding: 16px clamp(16px, 5vw, 48px);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .public-brand {
    margin-right: 28px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--ds-color-text-primary);
    text-decoration: none;
  }
  .brand-name { font-size: 20px; font-weight: 600; letter-spacing: -0.025em; }
  .public-links { display: flex; align-items: center; gap: 26px; }
  .public-links a,
  .public-links span {
    padding: 6px 0;
    color: var(--ds-color-text-secondary);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .public-links span[aria-current="page"] { color: var(--ds-color-text-primary); }
  .public-links a:hover { color: var(--ds-color-text-primary); }
  .open-screener {
    margin-left: 8px;
  }

  @media (max-width: 1000px) {
    .public-links { display: none; }
  }

  @media (max-width: 760px) {
    .public-nav { min-height: 64px; padding-block: 12px; flex-wrap: wrap; }
    .public-brand { margin-right: 0; }
    .open-screener { min-height: 38px; margin-left: auto; }
  }
</style>
