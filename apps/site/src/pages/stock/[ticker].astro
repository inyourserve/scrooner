          </thead>
          <tbody>
            {insiderTransactions.map((t) => (
              <tr data-open-market={t.transaction_code !== null && OPEN_MARKET_CODES.has(t.transaction_code) ? "true" : "false"}>
                <td>{t.reporting_owner_name}</td>
                <td>{t.officer_title ?? (t.is_director ? "Director" : t.is_ten_percent_owner ? "10%+ Owner" : "—")}</td>
                <td>{t.transaction_date}</td>
                <td>{t.acquired_disposed_code === "A" ? "Buy" : t.acquired_disposed_code === "D" ? "Sell" : t.transaction_code}</td>
                <td>{fmtShares(t.shares)}</td>
                <td>{t.price_per_share ? "$" + Number(t.price_per_share).toFixed(2) : "—"}</td>
                <td>{fmtShares(t.shares_owned_following)}</td>
                <td title={t.is_10b5_1_plan === null ? "Filed before the 2023-04-01 Rule 10b5-1(c) disclosure requirement" : t.is_10b5_1_plan ? "Pre-arranged Rule 10b5-1(c) trading plan" : "Discretionary transaction, not a disclosed 10b5-1 plan"}>
                  {t.is_10b5_1_plan === null ? "—" : t.is_10b5_1_plan ? "10b5-1" : "Discretionary"}
                </td>
                <td><a class="source-link" href={secFilingUrl(t.accession_number)} target="_blank" rel="noreferrer">SEC filing <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></td>
              </tr>
            ))}
            {insiderTransactions.length === 0 && <tr><td colspan="9"><em>No Form 4 activity on record.</em></td></tr>}
          </tbody>
        </table>
      </div>
      <p class="note" id="insider-filter-note">Showing open-market buys/sells only. Every open-market buy/sell/tax-withholding transaction disclosed by officers, directors, and 10%+ owners on Form 4, traced to its own accession number. "Plan" distinguishes a pre-arranged Rule 10b5-1(c) trading plan from a discretionary transaction (SEC disclosure required since 2023-04-01; "—" means the filing predates that requirement, not that no plan exists).</p>
      </details>
    </div>
    </details>
    <script>
      const select = document.getElementById("insider-filter") as HTMLSelectElement | null;
      const table = document.getElementById("insider-table");
      const note = document.getElementById("insider-filter-note");
      function applyFilter() {
        if (!select || !table) return;
        const openMarketOnly = select.value === "open-market";
        table.querySelectorAll("tbody tr[data-open-market]").forEach((row) => {
          const isOpenMarket = row.getAttribute("data-open-market") === "true";
          (row as HTMLElement).style.display = !openMarketOnly || isOpenMarket ? "" : "none";
        });
        if (note) {
          note.textContent = (openMarketOnly
            ? "Showing open-market buys/sells only. "
            : "Showing all disclosed transaction types, including grants, option exercises, gifts, and tax-related dispositions. ")
            + 'Every transaction disclosed by officers, directors, and 10%+ owners on Form 4, traced to its own accession number. "Plan" distinguishes a pre-arranged Rule 10b5-1(c) trading plan from a discretionary transaction (SEC disclosure required since 2023-04-01; "—" means the filing predates that requirement, not that no plan exists).';
        }
      }
      select?.addEventListener("change", applyFilter);
      applyFilter();
    </script>

    <details class="ownership-detail">
