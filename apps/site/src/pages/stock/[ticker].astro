                    <td>{h.report_period}</td>
                  </tr>
                ))}
                {institutionalSummary.top_holders.length === 0 && <tr><td colspan="8"><em>No Form 13F holdings on record.</em></td></tr>}
              </tbody>
            </table>
          </div>
          <p class="note">Top 10 institutional (Form 13F) holders, compared across the two most recent quarterly filing windows. Matched by CUSIP against SEC's bulk 13F data set — not filed by {company.ticker} itself. Form 13F excludes short positions and most derivatives, and is a quarter-end snapshot, not a real-time position.</p>
          </details>
        </>
      ) : (
        <>
          <div class="statement-scroll" tabindex="0" role="group" aria-label="Institutional holders, scroll horizontally for all columns">
            <table>
              <caption class="sr-only">Institutional holders of {company.company_name} reported on Form 13F.</caption>
              <thead>
                <tr><th scope="col">Manager</th><th scope="col">Shares</th><th scope="col">Value</th><th scope="col">As of</th></tr>
              </thead>
              <tbody>
                {institutionalHolders.map((h) => (
                  <tr>
                    <td>{h.filer_name}</td>
                    <td>{fmtShares(h.shares)}</td>
                    <td>{h.value_usd ? "$" + fmtNum(h.value_usd) : "—"}</td>
                    <td>{h.filing_date}</td>
                  </tr>
                ))}
                {institutionalHolders.length === 0 && <tr><td colspan="4"><em>No Form 13F holdings on record.</em></td></tr>}
              </tbody>
            </table>
          </div>
          <p class="note">The largest reported holders from SEC's bulk Form 13F institutional-manager data set, matched by CUSIP (not filed by {company.ticker} itself) — a single recent filing window, not yet the two-quarter trend built for a smaller set of companies.</p>
        </>
      )}
    </div>
    </details>

    <details class="ownership-detail">
      <summary><span>Mutual fund holders</span><span>{fundSummary ? `${fundSummary.total_funds_holding} funds · ${fundSummary.report_period_latest}` : "No summary available"}</span></summary>
    <div class="card ownership-detail-body">
      {fundSummary ? (
        <>
          <div class="ownership-flow" aria-label="Mutual fund position changes">
            <p><strong>{fundSummary.funds_increasing + fundSummary.new_positions}</strong> funds added or opened positions</p>
            <span aria-hidden="true">·</span>
            <p><strong>{fundSummary.funds_decreasing + fundSummary.exited_positions}</strong> reduced or closed positions</p>
            <span class="ownership-flow-period">Period ending {fundSummary.report_period_latest}</span>
          </div>
          <details class="data-disclosure">
            <summary><span>Top 10 mutual fund holders</span><span aria-hidden="true">View holders</span></summary>
          <div class="statement-scroll" tabindex="0" role="group" aria-label="Top mutual fund holders, scroll horizontally for all columns">
            <table>
              <caption class="sr-only">Top mutual fund holders of {company.company_name} reported on Form N-PORT, two most recent reporting periods.</caption>
              <thead>
                <tr><th scope="col">Fund</th><th scope="col">Fund family</th><th scope="col">Shares</th><th scope="col">Value</th><th scope="col">Portfolio weight</th><th scope="col">Share change</th><th scope="col">Position change %</th><th scope="col">Status</th><th scope="col">As of</th></tr>
              </thead>
              <tbody>
                {fundSummary.top_holders.map((h) => (
                  <tr>
                    <td>{h.fund_name}</td>
                    <td>{h.fund_family ?? "—"}</td>
                    <td>{fmtShares(h.shares)}</td>
                    <td>{h.value_usd ? "$" + fmtNum(h.value_usd) : "—"}</td>
                    <td>{h.portfolio_weight_pct ? Number(h.portfolio_weight_pct).toFixed(2) + "%" : "—"}</td>
                    <td>{h.share_change ? fmtSignedShares(h.share_change) : "—"}</td>
                    <td>{fmtHolderPctChange(h.pct_change)}</td>
                    <td><span class={`status-pill ${statusClass(h.status)}`}>{statusLabel(h.status)}</span></td>
                    <td>{h.report_period}</td>
                  </tr>
                ))}
                {fundSummary.top_holders.length === 0 && <tr><td colspan="9"><em>No Form N-PORT holdings on record.</em></td></tr>}
              </tbody>
            </table>
          </div>
          <p class="note">Top 10 mutual fund (Form N-PORT) holders, compared across the two most recent reporting periods. Portfolio weight (this stock's share of the fund's own portfolio) is shown when the fund's own filing reported it — a fund-level conviction signal distinct from {company.ticker}'s ownership percentage.</p>
          </details>
        </>
      ) : (
        <p class="data-empty">Mutual fund ownership isn't computed for this company yet — built and verified for a smaller golden set of companies so far (Form N-PORT, two-period comparison), not yet run against the full population.</p>
      )}
    </div>
    </details>

    <details class="ownership-detail">
      <summary><span>Reported holders above 5%</span><span>{beneficialOwnership.length} filing{beneficialOwnership.length === 1 ? "" : "s"}</span></summary>
    <div class="card ownership-detail-body">
      <p class="card-description">Disclosures from investors reporting a stake above the SEC threshold. Schedule 13D generally signals active intent; Schedule 13G generally signals passive ownership.</p>
      <details class="data-disclosure">
        <summary><span>{beneficialOwnership.length} reported holder{beneficialOwnership.length === 1 ? "" : "s"}</span><span aria-hidden="true">View holders</span></summary>
      <div class="statement-scroll" tabindex="0" role="group" aria-label="Major shareholders, scroll horizontally for all columns">
        <table>
          <caption class="sr-only">Schedule 13D/13G filers for {company.company_name}.</caption>
          <thead>
            <tr><th scope="col">Filer</th><th scope="col">Schedule</th><th scope="col">Date</th><th scope="col">Source</th></tr>
          </thead>
          <tbody>
            {beneficialOwnership.map((o) => (
              <tr>
                <td>{o.filer_name}</td>
                <td>{o.schedule_type}{o.is_amendment ? "/A" : ""}</td>
                <td>{o.filing_date}</td>
                <td><a class="source-link" href={secFilingUrl(o.accession_number)} target="_blank" rel="noreferrer">SEC filing <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></td>
              </tr>
            ))}
            {beneficialOwnership.length === 0 && <tr><td colspan="4"><em>No Schedule 13D/13G disclosures on record.</em></td></tr>}
          </tbody>
        </table>
      </div>
      <p class="note">Schedule 13D (activist intent) / 13G (passive) disclosures where {company.ticker} is confirmed as the actual subject company, not the filer. Ownership percentage/share count aren't extracted yet (free-text, not yet parsed); filer identity and filing date are.</p>
      </details>
    </div>
    </details>
  </section>

  <section class="page-section" id="documents">
    <div class="section-heading">
      <div>
        <h2>{company.company_name} documents</h2>
      </div>
      <p>Material events and periodic reports first, with direct SEC sources.</p>
    </div>
    <div class="card">
      <div class="filing-list">
        {recentFilings.length > 0 ? (
          recentFilings.map((f) => (
            <article class="filing-row">
              <div>
                <div class="filing-title">
                  <span class="form-badge">{f.form}</span>
                  <strong>{filingSummary(f.form, f.items)}</strong>
                </div>
                <p class="filing-meta">Filed {f.filing_date} · {f.accession_number}</p>
              </div>
              <a class="source-link" href={secFilingUrl(f.accession_number)} target="_blank" rel="noreferrer">View SEC filing <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            </article>
          ))
        ) : (
          <p class="data-empty data-empty--flush">No recent SEC filings are available for this company yet.</p>
        )}
      </div>
      {olderFilings.length > 0 && (
        <details class="data-disclosure filing-disclosure">
          <summary><span>{olderFilings.length} earlier filings</span><span aria-hidden="true">View filings</span></summary>
          <div class="filing-list">
            {olderFilings.map((f) => (
              <article class="filing-row">
                <div>
                  <div class="filing-title">
                    <span class="form-badge">{f.form}</span>
                    <strong>{filingSummary(f.form, f.items)}</strong>
                  </div>
                  <p class="filing-meta">Filed {f.filing_date} · {f.accession_number}</p>
                </div>
                <a class="source-link" href={secFilingUrl(f.accession_number)} target="_blank" rel="noreferrer">View SEC filing <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
              </article>
            ))}
          </div>
        </details>
      )}
      <details class="plain-disclosure">
        <summary>How filing labels are created</summary>
        <p>Event labels for 8-K filings use the SEC's structured item classification. Accession numbers remain visible as audit metadata, while the event meaning is presented first.</p>
      </details>
    </div>
  </section>

  {[
    { id: "quarterly-results", title: "Quarterly Financial Results", note: "Recent growth, margins and earnings", data: quarterlyResults, initialPeriods: 8, expandedPeriods: 12, investorRows: ["revenue", "sales", "gross profit", "operating income", "net income", "diluted eps", "earnings per share", "operating cash flow", "free cash flow"] },
    { id: "profit-loss", title: "Income Statement", note: "Annual revenue and profitability", data: incomeStatement, initialPeriods: 5, expandedPeriods: 10, investorRows: ["revenue", "sales", "cost of revenue", "gross profit", "operating expense", "operating income", "income before tax", "income tax", "net income", "basic eps", "diluted eps", "earnings per share", "weighted average shares", "depreciation"] },
    { id: "balance-sheet", title: "Balance Sheet", note: "Assets, obligations and shareholder capital", data: balanceSheet, initialPeriods: 5, expandedPeriods: 10, investorRows: ["cash", "short term investment", "accounts receivable", "inventory", "current assets", "property plant", "goodwill", "intangible", "total assets", "accounts payable", "short term debt", "long term debt", "total debt", "current liabilities", "total liabilities", "stockholders equity", "shareholders equity"] },
    { id: "cash-flow", title: "Cash Flow Statement", note: "Cash generated, invested and returned to shareholders", data: cashFlow, initialPeriods: 5, expandedPeriods: 10, investorRows: ["operating activities", "operating cash flow", "capital expenditure", "free cash flow", "acquisition", "debt", "repurchase", "dividend", "stock based compensation", "net change in cash"] },
  ].map((statement) => (
    <section class="page-section financial-section" id={statement.id}>
      <div class="section-heading">
        <div>
          <h2>{shortCompanyName} {statement.title}</h2>
          <p class="section-kicker">{statement.note}</p>
        </div>
        <div class="statement-meta">
          <span class="dataset-badge">Consolidated</span>
          <span class="statement-unit">USD · values auto-scaled</span>
        </div>
      </div>
      <p class="mobile-scroll-hint">Previous periods → Latest</p>
      <StockFinancialTable title={statement.title} companyName={company.company_name} statement={statement.data} emptyMessage={`No comparable ${statement.title.toLowerCase()} periods are available.`} investorRows={statement.investorRows} initialPeriods={statement.initialPeriods} expandedPeriods={statement.expandedPeriods} />
    </section>
  ))}

  <section class="page-section" id="ratios">
    <div class="section-heading">
      <div>
        <h2>{shortCompanyName} Financial Ratios</h2>
      </div>
      <p>Use this complete catalogue when you need a specific ratio or calculation.</p>
    </div>
    {categories.map((category) => (
      <details class="category" id={category.id}>
        <summary>
          <span class="category-title">{category.title}</span>
          <span class="category-count">{category.items.length} metrics</span>
        </summary>
        <div class="category-body">
          <MetricGrid items={category.items} dense />
        </div>
      </details>
    ))}
    <details class="plain-disclosure">
      <summary>How to read metric evidence</summary>
      <p>Every available value shows its reporting period. Missing values retain a specific null reason when the calculation pipeline provides one. Formula-level lineage remains a data-contract follow-up and is not implied by this page.</p>
    </details>
  </section>
  </main>

  <PublicFooter screenerUrl={screenerUrl} companyHref={Astro.url.pathname} />

  <div class="metric-tooltip" id="metric-tooltip" role="tooltip" hidden>
    <strong data-tooltip-title></strong>
    <p data-tooltip-copy></p>
    <small>Standardized financial-statement line</small>
  </div>

  <script>
    for (const group of document.querySelectorAll<HTMLElement>("[data-statement-tabs]")) {
      const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>("[role='tab']"));
      const panels = Array.from(group.querySelectorAll<HTMLElement>("[data-statement-panel]"));

      function activate(index: number, moveFocus = false) {
        tabs.forEach((tab, tabIndex) => {
          const active = tabIndex === index;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[tabIndex].hidden = !active;
        });
        if (moveFocus) tabs[index].focus();
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(index));
        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(next, true);
        });
      });

      activate(0);
    }

    for (const shell of document.querySelectorAll<HTMLElement>("[data-financial-table]")) {
      const rows = Array.from(shell.querySelectorAll<HTMLTableRowElement>("tbody tr[data-investor-row]"));
      const viewButtons = Array.from(shell.querySelectorAll<HTMLButtonElement>("[data-financial-view]"));
      const periodButtons = Array.from(shell.querySelectorAll<HTMLButtonElement>("[data-period-count]"));
      const empty = shell.querySelector<HTMLElement>(".financial-empty-filter");

      function setView(view: string) {
        let shown = 0;
        rows.forEach((row) => {
          const visible = view === "detailed" || row.dataset.investorRow === "true";
          row.hidden = !visible;
          if (visible) shown += 1;
        });
        viewButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.financialView === view)));
        if (empty) empty.hidden = shown > 0;
      }

      function setPeriods(value: string) {
        const count = value === "all" ? Number.POSITIVE_INFINITY : Number(value);
        const total = Number(shell.dataset.periodTotal ?? "0");
        const firstVisibleIndex = Number.isFinite(count) ? Math.max(0, total - count) : 0;
        shell.querySelectorAll<HTMLElement>("[data-period-index]").forEach((cell) => {
          cell.hidden = Number(cell.dataset.periodIndex) < firstVisibleIndex;
        });
        periodButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.periodCount === value)));
        const scrollArea = shell.querySelector<HTMLElement>(".statement-scroll");
        if (scrollArea) scrollArea.scrollLeft = scrollArea.scrollWidth;
      }

      viewButtons.forEach((button) => button.addEventListener("click", () => setView(button.dataset.financialView ?? "investor")));
      periodButtons.forEach((button) => button.addEventListener("click", () => setPeriods(button.dataset.periodCount ?? "all")));
      setView("investor");
      setPeriods(String(shell.dataset.initialPeriods ?? "5"));
    }

    const metricTooltip = document.getElementById("metric-tooltip");
    const tooltipTitle = metricTooltip?.querySelector<HTMLElement>("[data-tooltip-title]");
    const tooltipCopy = metricTooltip?.querySelector<HTMLElement>("[data-tooltip-copy]");
    let activeExplainer: HTMLButtonElement | null = null;

    function closeMetricTooltip() {
      if (!metricTooltip) return;
      metricTooltip.hidden = true;
      activeExplainer?.setAttribute("aria-expanded", "false");
      activeExplainer = null;
    }

    function openMetricTooltip(button: HTMLButtonElement) {
      if (!metricTooltip || !tooltipTitle || !tooltipCopy) return;
      activeExplainer?.setAttribute("aria-expanded", "false");
      activeExplainer = button;
      tooltipTitle.textContent = button.dataset.metricLabel ?? "Metric";
      tooltipCopy.textContent = button.dataset.metricExplanation ?? "No explanation is available.";
      metricTooltip.hidden = false;
      button.setAttribute("aria-expanded", "true");
      button.setAttribute("aria-describedby", "metric-tooltip");
      const anchor = button.getBoundingClientRect();
      const tooltip = metricTooltip.getBoundingClientRect();
      const left = Math.min(Math.max(12, anchor.left), window.innerWidth - tooltip.width - 12);
      const spaceBelow = window.innerHeight - anchor.bottom;
      const top = spaceBelow >= tooltip.height + 12 ? anchor.bottom + 8 : anchor.top - tooltip.height - 8;
      metricTooltip.style.left = `${left}px`;
      metricTooltip.style.top = `${Math.max(12, top)}px`;
    }

    document.querySelectorAll<HTMLButtonElement>(".metric-explainer-button").forEach((button) => {
      button.setAttribute("aria-expanded", "false");
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        if (activeExplainer === button) closeMetricTooltip();
        else openMetricTooltip(button);
      });
      button.addEventListener("mouseenter", () => openMetricTooltip(button));
      button.addEventListener("mouseleave", closeMetricTooltip);
      button.addEventListener("focus", () => openMetricTooltip(button));
      button.addEventListener("blur", closeMetricTooltip);
    });
    document.addEventListener("click", closeMetricTooltip);
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMetricTooltip(); });
    window.addEventListener("scroll", closeMetricTooltip, true);
    window.addEventListener("resize", closeMetricTooltip);

    const chart = document.querySelector<HTMLElement>("[data-price-chart]");
    if (chart) {
      const raw = chart.querySelector<HTMLScriptElement>("[data-chart-data]")?.textContent ?? "[]";
      const points = JSON.parse(raw) as { date: string; price: string }[];
      const line = chart.querySelector<SVGPolylineElement>("[data-chart-line]");
      const price = chart.querySelector<HTMLElement>("[data-chart-price]");
      const period = chart.querySelector<HTMLElement>("[data-chart-period]");
      const start = chart.querySelector<HTMLElement>("[data-chart-start]");
      const end = chart.querySelector<HTMLElement>("[data-chart-end]");
      const labels = new Map([[30, "1 month"], [180, "6 months"], [365, "1 year"], [1095, "3 years"], [1825, "5 years"], [3650, "10 years"], [0, "maximum history"]]);

      function draw(days: number) {
        const lastDate = new Date(points.at(-1)?.date ?? Date.now());
        const cutoff = new Date(lastDate);
        if (days) cutoff.setDate(cutoff.getDate() - days);
        const visible = days ? points.filter((point) => new Date(point.date) >= cutoff) : points;
        const values = visible.map((point) => Number(point.price));
        const min = Math.min(...values);
        const max = Math.max(...values);
        const spread = max - min || 1;
        line?.setAttribute("points", visible.map((point, index) => {
          const x = visible.length === 1 ? 0 : index / (visible.length - 1) * 1000;
          const y = 285 - ((Number(point.price) - min) / spread * 270);
          return `${x.toFixed(1)},${y.toFixed(1)}`;
        }).join(" "));
        if (price) price.textContent = `$${values.at(-1)?.toFixed(2) ?? "—"}`;
        if (period) period.textContent = labels.get(days) ?? "selected period";
        if (start) start.textContent = visible.at(0)?.date ?? "";
        if (end) end.textContent = visible.at(-1)?.date ?? "";
      }

      document.querySelectorAll<HTMLButtonElement>("[data-chart-days]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll<HTMLButtonElement>("[data-chart-days]").forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
          draw(Number(button.dataset.chartDays));
        });
      });
      draw(365);
    }

    const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".section-nav a"));
    const observedSections = sectionLinks.map((link) => document.querySelector<HTMLElement>(link.hash)).filter((section): section is HTMLElement => section !== null);
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      sectionLinks.forEach((link) => {
        if (link.hash === `#${visible.target.id}`) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }, { rootMargin: "-20% 0px -65%", threshold: [0, 0.25, 0.5] });
    observedSections.forEach((section) => observer.observe(section));
  </script>
</body>
</html>
