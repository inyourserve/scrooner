---
// /stock/{ticker}/ -- "the crown jewel" (DOCUMENTATION.md sec 1, sec 3.2).
// Structure grounded in doc 17's real analysis of Screener.in's own page,
// mapped honestly against what Scrooner's pipeline actually has verified.
// Reads Postgres directly (doc 04/17) -- no apps/backend dependency.

import {
  getCompanyByTicker,
  getLatestMetrics,
  getStatement,
  getRecentFilings,
  getRecentInsiderTransactions,
  getRecentBeneficialOwnership,
  getTopInstitutionalHolders,
  getLatestPublicFloat,
  getLatestPrice,
  getLatestConceptValue,
} from "../../lib/db";
import { buildChecklist } from "../../lib/prosCons";

const { ticker } = Astro.params;
const company = ticker ? await getCompanyByTicker(ticker) : null;

if (!company) {
  return new Response("Company not found", { status: 404 });
}

const metrics = await getLatestMetrics(company.id);
const checklist = await buildChecklist(company.id, metrics);
const quarterlyResults = await getStatement(company.id, "income_statement", "quarterly");
const incomeStatement = await getStatement(company.id, "income_statement");
const balanceSheet = await getStatement(company.id, "balance_sheet");
const cashFlow = await getStatement(company.id, "cash_flow");
const filings = await getRecentFilings(company.id);
const insiderTransactions = await getRecentInsiderTransactions(company.id);
const beneficialOwnership = await getRecentBeneficialOwnership(company.id);
const institutionalHolders = await getTopInstitutionalHolders(company.id);
const publicFloat = await getLatestPublicFloat(company.id);
const latestPrice = await getLatestPrice(company.id);
const bookValue = await getLatestConceptValue(company.id, "stockholders_equity");

// doc 25 follow-on (mapper/price_metrics.py): the 6 price-dependent
// metrics doc 02 locked from day one are now real, computed values in
// analytics.metric_value (TTM-labeled, same table getLatestMetrics
// already reads generically) -- no query change needed here, just
// wiring the display. `blocked` now only fires when this specific
// company's row is genuinely null (e.g. ENB/TSM's known foreign-filer
// taxonomy gap, or a real missing-input reason) -- never a blanket
// "not built yet" the way it was before this stage existed.
function fmtPct(value: string | null | undefined): string {
  if (value === null || value === undefined) return "—";
  return (Number(value) * 100).toFixed(1) + "%";
}

function fmtNum(value: string | null): string {
  if (value === null) return "—";
  const n = Number(value);
  if (Math.abs(n) >= 1e9) return (n / 1e9).toFixed(2) + "B";
  if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(2) + "M";
  return n.toFixed(2);
}

function fmtMultiple(value: string | null | undefined): string {
  if (value === null || value === undefined) return "—";
  return Number(value).toFixed(2) + "x";
}

function fmtDays(value: string | null | undefined): string {
  if (value === null || value === undefined) return "—";
  return Number(value).toFixed(1) + "d";
}

const topRatios: { label: string; row: (typeof metrics)[string] | undefined; kind: "pct" | "dollar" | "multiple" | "raw"; raw?: string; nullTitle?: string }[] = [
  { label: "Market Cap", row: metrics["market_cap"], kind: "dollar" },
  { label: "Current Price", row: undefined, kind: "raw", raw: latestPrice ? "$" + Number(latestPrice.price).toFixed(2) : undefined, nullTitle: "No real price on record for this company (Alpaca coverage gap) -- see doc 25" },
  { label: "Stock P/E", row: metrics["trailing_pe"], kind: "multiple" },
  { label: "Price/Sales", row: metrics["price_to_sales"], kind: "multiple" },
  { label: "Price/Book", row: metrics["price_to_book"], kind: "multiple" },
  { label: "Book Value (Equity)", row: undefined, kind: "raw", raw: bookValue ? "$" + fmtNum(bookValue) : undefined, nullTitle: "No stockholders' equity fact resolved for this company" },
  { label: "Dividend Yield", row: metrics["dividend_yield"], kind: "pct" },
  { label: "FCF Yield", row: metrics["fcf_yield"], kind: "pct" },
  { label: "ROE", row: metrics["roe"], kind: "pct" },
  { label: "ROIC", row: metrics["roic"], kind: "pct" },
];

// doc 18 Tier A / doc 26 (2026-08-18): the 12 metrics built to raise data-
// point coverage past the original doc-02 18. Same generic getLatestMetrics
// read, same honest-null discipline as topRatios -- just a second grid so
// the original locked 18-metric set stays visually distinct from these
// additive extensions.
const moreRatios: { label: string; row: (typeof metrics)[string] | undefined; kind: "pct" | "dollar" | "multiple" | "raw" | "days" }[] = [
  { label: "ROA", row: metrics["roa"], kind: "pct" },
  { label: "Quick Ratio", row: metrics["quick_ratio"], kind: "multiple" },
  { label: "EBITDA", row: metrics["ebitda"], kind: "dollar" },
  { label: "Net Debt / EBITDA", row: metrics["net_debt_ebitda"], kind: "multiple" },
  { label: "EV / EBITDA", row: metrics["ev_ebitda"], kind: "multiple" },
  { label: "EV / Sales", row: metrics["ev_sales"], kind: "multiple" },
  { label: "PEG Ratio", row: metrics["peg_ratio"], kind: "multiple" },
  { label: "SBC % of Revenue", row: metrics["sbc_pct_revenue"], kind: "pct" },
  { label: "Debtor Days", row: metrics["debtor_days"], kind: "days" },
  { label: "Inventory Days", row: metrics["inventory_days"], kind: "days" },
  { label: "Payables Days", row: metrics["payables_days"], kind: "days" },
  { label: "Cash Conversion Cycle", row: metrics["cash_conversion_cycle"], kind: "days" },
  { label: "Buyback Yield", row: metrics["buyback_yield"], kind: "pct" },
  { label: "Total Shareholder Yield", row: metrics["total_shareholder_yield"], kind: "pct" },
  { label: "Share Count Dilution (YoY)", row: metrics["share_dilution_trend"], kind: "pct" },
  { label: "Institutional Ownership", row: metrics["institutional_ownership_pct"], kind: "pct" },
];

// SEC's own standardized 8-K item codes (doc 21/24 Phase 1) -- a small,
// curated map, not exhaustive, same "curated not fuzzy" discipline as
// ai_query/aliases.py. Unmapped codes fall back to showing the raw code.
const ITEM_LABELS: Record<string, string> = {
  "1.01": "Material Agreement",
  "1.02": "Termination of Material Agreement",
  "2.01": "Completion of Acquisition/Disposition",
  "2.02": "Earnings Results",
  "2.03": "Direct Financial Obligation",
  "3.01": "Delisting/Non-Compliance Notice",
  "3.02": "Unregistered Equity Sale",
  "3.03": "Rights of Security Holders Modified",
  "5.01": "Change in Control",
  "5.02": "Officer/Director Change",
  "5.03": "Bylaw/Charter Amendment",
  "5.07": "Shareholder Vote",
  "5.08": "Shareholder Director Nominations",
  "7.01": "Reg FD Disclosure",
  "8.01": "Other Events",
  "9.01": "Financial Statements/Exhibits",
};

// Share counts are whole numbers (Form 4 shares/shares_owned_following) --
// a separate formatter from fmtNum so the statement tables' dollar-figure
// 2-decimal formatting (already verified, doc 17) isn't touched.
function fmtShares(value: string | null): string {
  if (value === null) return "—";
  const n = Number(value);
  if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(2) + "M";
  return n.toLocaleString("en-US");
}
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{company.company_name} ({company.ticker}) — Scrooner</title>
  <style>
    body { font-family: -apple-system, system-ui, sans-serif; max-width: 1000px; margin: 0 auto; padding: 24px; color: #1a1a1a; }
    h1 { margin-bottom: 4px; }
    .sub { color: #666; margin-bottom: 24px; }
    .card { border: 1px solid #e2e2e2; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px; }
    .ratio-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
    .ratio { display: flex; flex-direction: column; }
    .ratio .label { font-size: 12px; color: #777; }
    .ratio .value { font-size: 18px; font-weight: 600; }
    .ratio .value.blocked { color: #aaa; font-weight: 400; font-size: 14px; }
    table { border-collapse: collapse; width: 100%; font-size: 13px; }
    th, td { text-align: right; padding: 6px 10px; border-bottom: 1px solid #eee; white-space: nowrap; }
    th:first-child, td:first-child { text-align: left; }
    .pros-cons { display: flex; gap: 24px; flex-wrap: wrap; }
    .pros, .cons { flex: 1; min-width: 260px; }
    .pros h3 { color: #1a7f37; } .cons h3 { color: #b91c1c; }
    ul { padding-left: 18px; margin: 8px 0; }
    .note { font-size: 12px; color: #888; margin-top: 8px; }
    .statement-scroll { overflow-x: auto; }
  </style>
</head>
<body>
  <h1>{company.company_name}</h1>
  <p class="sub">{company.ticker} · {company.sic_description ?? "Sector unclassified"} · {company.status}</p>

  <section class="card">
    <div class="ratio-grid">
      {topRatios.map((r) => {
        const isNull = r.kind === "raw" ? !r.raw : r.row?.value == null;
        const nullTitle = r.kind === "raw"
          ? (r.nullTitle ?? "Not available for this company")
          : r.row?.is_null_reason
            ? `Not computed: ${r.row.is_null_reason} -- see mapper/price_metrics.py`
            : "Not yet resolved for this company";
        return (
          <div class="ratio">
            <span class="label">{r.label}</span>
            {isNull ? (
              <span class="value blocked" title={nullTitle}>—</span>
            ) : r.kind === "raw" ? (
              <span class="value" title={`${latestPrice?.feed} feed, bar time ${latestPrice?.bar_timestamp} -- see doc 25`}>{r.raw}</span>
            ) : r.kind === "dollar" ? (
              <span class="value">${fmtNum(r.row?.value ?? null)}</span>
            ) : r.kind === "multiple" ? (
              <span class="value">{fmtMultiple(r.row?.value)}</span>
            ) : (
              <span class="value">{fmtPct(r.row?.value)}</span>
            )}
          </div>
        );
      })}
    </div>
    <p class="note">Price-dependent figures are computed from a real price (Alpaca, {latestPrice?.feed ?? "delayed_sip"} feed, ~15min delay) combined with trailing-twelve-month fundamentals — see doc 25. A "—" here always has a specific, traceable reason (hover to see it) — never a guess.</p>
    {publicFloat && (
      <p class="note">
        <strong>Public Float</strong> (not Market Cap — value of shares held by non-affiliates only, as of {publicFloat.period_end}, per the 10-K cover page): {fmtNum(publicFloat.value)}
      </p>
    )}
  </section>

  <section class="card">
    <h2>Additional Ratios</h2>
    <div class="ratio-grid">
      {moreRatios.map((r) => {
        const isNull = r.row?.value == null;
        const nullTitle = r.row?.is_null_reason
          ? `Not computed: ${r.row.is_null_reason} -- see mapper/expanded_metrics.py`
          : "Not yet resolved for this company";
        return (
          <div class="ratio">
            <span class="label">{r.label}</span>
            {isNull ? (
              <span class="value blocked" title={nullTitle}>—</span>
            ) : r.kind === "dollar" ? (
              <span class="value">${fmtNum(r.row?.value ?? null)}</span>
            ) : r.kind === "multiple" ? (
              <span class="value">{fmtMultiple(r.row?.value)}</span>
            ) : r.kind === "days" ? (
              <span class="value">{fmtDays(r.row?.value)}</span>
            ) : (
              <span class="value">{fmtPct(r.row?.value)}</span>
            )}
          </div>
        );
      })}
    </div>
    <p class="note">Doc 18 Tier A / doc 26 extensions, built to raise data-point coverage past doc 02's original locked 18 — same honest-null discipline (hover a "—" for the specific reason). Institutional Ownership is Form-13F-reported holdings only (a single recent filing window, not exhaustive of all beneficial owners) — see doc 19 Stage 4.</p>
  </section>

  <section class="card">
    <h2>Analysis</h2>
    <div class="pros-cons">
      <div class="pros">
        <h3>Pros</h3>
        <ul>
          {checklist.filter((c) => c.kind === "pro").map((c) => <li>{c.text}</li>)}
          {checklist.filter((c) => c.kind === "pro").length === 0 && <li><em>None triggered by the current checklist.</em></li>}
        </ul>
      </div>
      <div class="cons">
        <h3>Cons</h3>
        <ul>
          {checklist.filter((c) => c.kind === "con").map((c) => <li>{c.text}</li>)}
          {checklist.filter((c) => c.kind === "con").length === 0 && <li><em>None triggered by the current checklist.</em></li>}
        </ul>
      </div>
    </div>
    <p class="note">Pros/cons are machine generated from a fixed checklist against verified metrics — never AI-generated prose. See doc 17.</p>
  </section>

  {[
    { title: "Quarterly Results", data: quarterlyResults },
    { title: "Profit & Loss (Annual)", data: incomeStatement },
    { title: "Balance Sheet (Annual)", data: balanceSheet },
    { title: "Cash Flow (Annual)", data: cashFlow },
  ].map(({ title, data }) => (
    <section class="card">
      <h2>{title}</h2>
      <div class="statement-scroll">
        <table>
          <thead>
            <tr>
              <th>&nbsp;</th>
              {data.periods.slice(-8).map((p) => <th>{p.fiscal_period} {p.fiscal_year}</th>)}
            </tr>
          </thead>
          <tbody>
            {data.lines.map((line) => (
              <tr>
                <td>{line.label}</td>
                {line.values.slice(-8).map((v) => <td>{fmtNum(v)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="card">
    <h2>Insider Activity</h2>
    <div class="statement-scroll">
      <table>
        <thead>
          <tr><th style="text-align:left">Insider</th><th style="text-align:left">Title</th><th>Date</th><th>Type</th><th>Shares</th><th>Price</th><th>Owned After</th><th>Plan</th></tr>
        </thead>
        <tbody>
          {insiderTransactions.map((t) => (
            <tr>
              <td style="text-align:left">{t.reporting_owner_name}</td>
              <td style="text-align:left">{t.officer_title ?? (t.is_director ? "Director" : t.is_ten_percent_owner ? "10%+ Owner" : "—")}</td>
              <td>{t.transaction_date}</td>
              <td>{t.acquired_disposed_code === "A" ? "Buy" : t.acquired_disposed_code === "D" ? "Sell" : t.transaction_code}</td>
              <td>{fmtShares(t.shares)}</td>
              <td>{t.price_per_share ? "$" + Number(t.price_per_share).toFixed(2) : "—"}</td>
              <td>{fmtShares(t.shares_owned_following)}</td>
              <td title={t.is_10b5_1_plan === null ? "Filed before the 2023-04-01 Rule 10b5-1(c) disclosure requirement" : t.is_10b5_1_plan ? "Pre-arranged Rule 10b5-1(c) trading plan" : "Discretionary transaction, not a disclosed 10b5-1 plan"}>
                {t.is_10b5_1_plan === null ? "—" : t.is_10b5_1_plan ? "10b5-1" : "Discretionary"}
              </td>
            </tr>
          ))}
          {insiderTransactions.length === 0 && <tr><td colspan="8" style="text-align:left"><em>No Form 4 activity on record.</em></td></tr>}
        </tbody>
      </table>
    </div>
    <p class="note">Every open-market buy/sell/tax-withholding transaction disclosed by officers, directors, and 10%+ owners on Form 4, traced to its own accession number. See doc 19. "Plan" distinguishes a pre-arranged Rule 10b5-1(c) trading plan from a discretionary transaction (SEC disclosure required since 2023-04-01; "—" means the filing predates that requirement, not that no plan exists) — see doc 23 Stage A.</p>
  </section>

  <section class="card">
    <h2>Institutional Ownership</h2>
    <div class="statement-scroll">
      <table>
        <thead>
          <tr><th style="text-align:left">Manager</th><th>Shares</th><th>Value</th><th>As of</th></tr>
        </thead>
        <tbody>
          {institutionalHolders.map((h) => (
            <tr>
              <td style="text-align:left">{h.filer_name}</td>
              <td>{fmtShares(h.shares)}</td>
              <td>{h.value_usd ? "$" + fmtNum(h.value_usd) : "—"}</td>
              <td>{h.filing_date}</td>
            </tr>
          ))}
          {institutionalHolders.length === 0 && <tr><td colspan="4" style="text-align:left"><em>No Form 13F holdings on record.</em></td></tr>}
        </tbody>
      </table>
    </div>
    <p class="note">The largest reported holders from SEC's bulk Form 13F institutional-manager data set, matched by CUSIP (not filed by {company.ticker} itself) — a single recent filing window, not a historical trend. See doc 19 Stage 4.</p>
  </section>

  <section class="card">
    <h2>Major Shareholders (&gt;5% stakes)</h2>
    <div class="statement-scroll">
      <table>
        <thead>
          <tr><th style="text-align:left">Filer</th><th>Schedule</th><th>Date</th></tr>
        </thead>
        <tbody>
          {beneficialOwnership.map((o) => (
            <tr>
              <td style="text-align:left">{o.filer_name}</td>
              <td>{o.schedule_type}{o.is_amendment ? "/A" : ""}</td>
              <td>{o.filing_date}</td>
            </tr>
          ))}
          {beneficialOwnership.length === 0 && <tr><td colspan="3" style="text-align:left"><em>No Schedule 13D/13G disclosures on record.</em></td></tr>}
        </tbody>
      </table>
    </div>
    <p class="note">Schedule 13D (activist intent) / 13G (passive) disclosures where {company.ticker} is confirmed as the actual subject company, not the filer — see doc 19's issuer-vs-filer finding. Ownership percentage/share count aren't extracted yet (free-text, not yet parsed); filer identity and filing date are.</p>
  </section>

  <section class="card">
    <h2>Recent Filings</h2>
    <ul>
      {filings.map((f) => (
        <li>
          {f.form} — {f.filing_date} <span class="note">({f.accession_number})</span>
          {f.items && <span class="note"> — {f.items.split(",").map((i) => ITEM_LABELS[i.trim()] ?? i.trim()).join("; ")}</span>}
        </li>
      ))}
    </ul>
    <p class="note">8-K entries show SEC's own structured event classification where available — see doc 21/24.</p>
  </section>
</body>
</html>
