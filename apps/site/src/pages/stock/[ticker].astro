        <div class="statement-scroll" tabindex="0" role="group" aria-label="Insider rolling buy/sell summary, scroll horizontally for all columns">
          <table>
            <caption class="sr-only">Rolling insider buy/sell summary for {company.company_name}, open-market transactions only.</caption>
            <thead>
              <tr><th scope="col">Window</th><th scope="col">Net $ (buy − sell)</th><th scope="col">Gross bought</th><th scope="col">Gross sold</th><th scope="col">Insiders buying</th><th scope="col">Insiders selling</th><th scope="col">Largest purchase</th><th scope="col">Largest sale</th></tr>
            </thead>
            <tbody>
              {insiderWindowSummary.map((w) => {
                const net = netInsiderValue(w);
                return (
                  <tr>
                    <td>{WINDOW_LABELS[w.window_months] ?? `${w.window_months} months`}</td>
                    <td class={net > 0 ? "value-positive" : net < 0 ? "value-negative" : undefined}>{fmtSignedDollar(net)}</td>
                    <td>{"$" + fmtNum(w.buy_dollar_volume)}</td>
                    <td>{"$" + fmtNum(w.sell_dollar_volume)}</td>
                    <td>{w.insiders_buying_count}</td>
                    <td>{w.insiders_selling_count}</td>
                    <td>{w.largest_purchase_value ? `$${fmtNum(w.largest_purchase_value)} (${w.largest_purchase_owner_name})` : "—"}</td>
                    <td>{w.largest_sale_value ? `$${fmtNum(w.largest_sale_value)} (${w.largest_sale_owner_name})` : "—"}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        </details>
      )}
      <details class="data-disclosure">
        <summary><span>Individual insider transactions</span><span aria-hidden="true">View transactions</span></summary>
        <div class="ownership-toggle">
        <label for="insider-filter">Show</label>
        <select id="insider-filter">
          <option value="open-market" selected>Open-market buys/sells only</option>
          <option value="all">All transaction types (incl. grants, exercises, gifts)</option>
        </select>
      </div>
      <div class="statement-scroll" tabindex="0" role="group" aria-label="Insider activity, scroll horizontally for all columns">
        <table class="insider-table" id="insider-table">
          <caption class="sr-only">Form 4 insider transactions for {company.company_name}.</caption>
          <thead>
            <tr>
              <th scope="col">Insider</th><th scope="col">Title</th><th scope="col">Date</th><th scope="col">Type</th><th scope="col">Shares</th><th scope="col">Price</th><th scope="col">Owned After</th><th scope="col">Plan</th><th scope="col">Source</th>
