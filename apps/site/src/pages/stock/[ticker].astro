            <table>
              <caption class="sr-only">Top institutional holders of {company.company_name} reported on Form 13F, two most recent quarters.</caption>
              <thead>
                <tr><th scope="col">Manager</th><th scope="col">Shares</th><th scope="col">Value</th><th scope="col">Ownership %</th><th scope="col">Share change</th><th scope="col">Position change %</th><th scope="col">Status</th><th scope="col">As of</th></tr>
              </thead>
              <tbody>
                {institutionalSummary.top_holders.map((h) => (
                  <tr>
                    <td>{h.filer_name}</td>
                    <td>{fmtShares(h.shares)}</td>
                    <td>{h.value_usd ? "$" + fmtNum(h.value_usd) : "—"}</td>
