        <div><span>Insider ownership</span><strong>{fmtPct(insiderOwnershipSummary?.ownership_pct)}</strong><small>{insiderOwnershipSummary ? `${insiderOwnershipSummary.distinct_insiders_count} reporting insiders` : "Not available"}</small></div>
        <div><span>Held through mutual funds</span><strong>{fmtPct(fundSummary?.total_fund_ownership_pct)}</strong><small>Included within institutions</small></div>
