---
// /stock/{ticker}/ -- "the crown jewel" (DOCUMENTATION.md sec 1, sec 3.2).
// Structure grounded in doc 17's real analysis of Screener.in's own page,
// then re-aligned with doc/design/10_Scrooner_Product_Design_Framework.md
// (Sec 8.4/12/13/14/17) once that framework existed. Reads Postgres
// directly (doc 04/17) -- no apps/backend dependency.
//
// Redesign notes (2026-08-19), so a future edit doesn't re-litigate why:
// - Design framework Sec 12.2 found this page rendering 39 metrics in two
//   flat, uncurated grids -- worse, 8 of the ORIGINAL doc 02 locked
//   metrics (gross/operating/net margin, current ratio, debt/equity,
//   interest coverage, fcf, fcf margin) were never wired in at all,
//   despite being computed since Mapper Stage 3d. Fixed here: all 45
//   metrics now render, split into a curated 8-item "Key metrics" set
//   (framework Sec 12.2's own recommended list, using this project's real
//   metric names) plus 7 named, always-visible categories (framework Sec
//   10.2's investor-language grouping) -- all shown at once by explicit
//   request, not collapsed behind a click.
// - Null states now carry an aria-label, not just a hover `title` --
//   framework Sec 17.2: "a dash must not be the only accessible label for
//   a missing value." See components/MetricGrid.astro.
// - Current Price moved into the company header (framework Sec 12.1's own
//   worked example puts price beside identity, not inside a metrics
//   grid); Book Value moved into the Valuation category.
// - Public visual tokens and shell now follow the homepage reference
//   direction and are shared through public-theme.css, PublicHeader, and
//   PublicFooter. The app domain keeps its workflow-specific shell.
import {
  getCompanyPageData,
  type MetricRow,
} from "../../lib/db";
import { buildChecklist } from "../../lib/prosCons";
import { fmtNum, fmtShares, fmtPct } from "../../lib/format";
import MetricGrid, { type MetricItem } from "../../components/MetricGrid.astro";
import StockFinancialTable from "../../components/StockFinancialTable.astro";
import PublicHeader from "../../components/PublicHeader.astro";
import PublicFooter from "../../components/PublicFooter.astro";
import "../../styles/public-theme.css";
import "../../styles/company-research.css";

const { ticker } = Astro.params;
const requestedTicker = ticker ?? "";
const dbStartedAt = performance.now();
const pageData = requestedTicker ? await getCompanyPageData(requestedTicker) : null;
const dbDurationMs = performance.now() - dbStartedAt;

if (!pageData) {
  return new Response("Company not found", { status: 404 });
}

const {
  company,
  metrics,
  quarterlyResults,
  incomeStatement,
  balanceSheet,
  cashFlow,
  filings,
  insiderTransactions,
  beneficialOwnership,
  institutionalHolders,
  publicFloat,
  latestPrice,
  priceHistory,
  bookValue,
  metricHistory,
  metricTrendHistory,
  peerCompanies,
  insiderOwnershipSummary,
  insiderWindowSummary,
  institutionalSummary,
  fundSummary,
  employeeHeadcountHistory,
  segmentRevenue,
} = pageData;

// Public company pages are identical for every visitor. Astro's Vercel cache
// provider serves a fresh response for 15 minutes, then may serve stale HTML
// while one background request refreshes it. Development mode intentionally
// disables the cache, which keeps local data iteration predictable.
if (Astro.cache.enabled) {
  Astro.cache.set({
    maxAge: 900,
    swr: 86400,
    tags: [`stock:${company.ticker?.toLowerCase() ?? requestedTicker.toLowerCase()}`],
  });
}

// This header appears on origin renders and makes the one-query contract
// observable without exposing SQL or connection details.
Astro.response.headers.set(
  "Server-Timing",
  `db;dur=${dbDurationMs.toFixed(1)};desc="company-page-read"`,
);
Astro.response.headers.set("X-Scrooner-DB-Queries", "1");

const availableMetricCount = Object.values(metrics).filter((row) => row.value !== null).length;
const trackedMetricCount = Object.keys(metrics).length;
function filingPriority(form: string, items: string | null): number {
  if (form.startsWith("8-K") && items) return 0;
  if (form.startsWith("10-Q")) return 1;
  if (form.startsWith("10-K")) return 2;
  if (form.includes("13D") || form.includes("13G")) return 3;
  return 4;
}
const prioritizedFilings = [...filings].sort((a, b) => filingPriority(a.form, a.items) - filingPriority(b.form, b.items) || b.filing_date.localeCompare(a.filing_date));
const recentFilings = prioritizedFilings.slice(0, 5);
const olderFilings = prioritizedFilings.slice(5);
const checklist = buildChecklist(metrics, metricHistory);
const strengths = checklist.filter((item) => item.kind === "pro");
const risks = checklist.filter((item) => item.kind === "con");
const appUrl = (import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
const screenerUrl = `${appUrl}/screener`;
const shortCompanyName = company.company_name.replace(/\s+(incorporated|inc\.?|corporation|corp\.?|company|co\.?|limited|ltd\.?)$/i, "");
const cleanAboutText = company.about_text?.replace(/^\s*company background\s*[:—-]?\s*/i, "").trim();

function clarifyObservation(text: string): string {
  return text.replace(/\s+over the last 3 years\.?$/i, " · 3-year average.");
}

function m(name: string): MetricRow | undefined {
  return metrics[name];
}

// All 45 metric_definition rows, none silently dropped -- grouped using
// the same investor-language categories the design framework's filter
// builder (Sec 10.2) uses, so the vocabulary matches across the whole
// product rather than this page inventing its own taxonomy.
const categories: { id: string; title: string; items: MetricItem[] }[] = [
  {
    id: "valuation",
    title: "Valuation",
    items: [
      { label: "Price / Sales", row: m("price_to_sales"), kind: "multiple" },
      { label: "Price / Book", row: m("price_to_book"), kind: "multiple" },
      { label: "Book Value (Equity)", kind: "raw", raw: bookValue ? "$" + fmtNum(bookValue) : undefined, nullReason: "No stockholders' equity fact resolved for this company" },
      { label: "Dividend Yield", row: m("dividend_yield"), kind: "pct" },
      { label: "PEG Ratio", row: m("peg_ratio"), kind: "multiple" },
      { label: "EV / EBITDA", row: m("ev_ebitda"), kind: "multiple" },
      { label: "EV / Sales", row: m("ev_sales"), kind: "multiple" },
    ],
  },
  {
    id: "growth",
    title: "Growth",
    items: [
      { label: "Revenue Growth (YoY)", row: m("revenue_growth_yoy"), kind: "pct" },
      { label: "Revenue Growth (5Y CAGR)", row: m("revenue_growth_5y_cagr"), kind: "pct" },
      { label: "Revenue Growth (10Y CAGR)", row: m("revenue_growth_10y_cagr"), kind: "pct" },
      { label: "EPS Growth (YoY)", row: m("eps_growth_yoy"), kind: "pct" },
      { label: "EPS Growth (3Y CAGR)", row: m("eps_growth_3y_cagr"), kind: "pct" },
      { label: "EPS Growth (5Y CAGR)", row: m("eps_growth_5y_cagr"), kind: "pct" },
      { label: "EPS Growth (10Y CAGR)", row: m("eps_growth_10y_cagr"), kind: "pct" },
    ],
  },
  {
    id: "profitability",
    title: "Profitability",
    items: [
      { label: "Gross Margin", row: m("gross_margin"), kind: "pct" },
      { label: "Net Margin", row: m("net_margin"), kind: "pct" },
      { label: "ROE", row: m("roe"), kind: "pct" },
      { label: "ROA", row: m("roa"), kind: "pct" },
      { label: "SBC % of Revenue", row: m("sbc_pct_revenue"), kind: "pct" },
    ],
  },
  {
    id: "cash-flow",
    title: "Cash Flow & Efficiency",
    items: [
      { label: "Free Cash Flow", row: m("fcf"), kind: "dollar" },
      { label: "FCF Margin", row: m("fcf_margin"), kind: "pct" },
      { label: "Cash Conversion Cycle", row: m("cash_conversion_cycle"), kind: "days" },
      { label: "Debtor Days", row: m("debtor_days"), kind: "days" },
      { label: "Inventory Days", row: m("inventory_days"), kind: "days" },
      { label: "Payables Days", row: m("payables_days"), kind: "days" },
    ],
  },
  {
    id: "financial-strength",
    title: "Financial Strength",
    items: [
      { label: "Current Ratio", row: m("current_ratio"), kind: "multiple" },
      { label: "Quick Ratio", row: m("quick_ratio"), kind: "multiple" },
      { label: "Interest Coverage", row: m("interest_coverage_ratio"), kind: "multiple" },
      { label: "EBITDA", row: m("ebitda"), kind: "dollar" },
      { label: "Net Debt / EBITDA", row: m("net_debt_ebitda"), kind: "multiple" },
      { label: "Debt-Free", row: m("zero_debt"), kind: "bool" },
      { label: "Piotroski F-Score", row: m("piotroski_f_score"), kind: "score" },
    ],
  },
  {
    id: "capital-allocation",
    title: "Capital Allocation & Quality",
    items: [
      { label: "Buyback Yield", row: m("buyback_yield"), kind: "pct" },
      { label: "Total Shareholder Yield", row: m("total_shareholder_yield"), kind: "pct" },
      { label: "FCF > Net Income", row: m("fcf_gt_net_income"), kind: "bool" },
      { label: "Profitable Streak", row: m("profitable_streak_years"), kind: "years" },
      { label: "Margin Expanding (3yr)", row: m("margin_expanding_3yr"), kind: "bool" },
    ],
  },
  {
    id: "ownership-metrics",
    title: "Ownership",
    items: [
      { label: "Institutional Ownership", row: m("institutional_ownership_pct"), kind: "pct" },
    ],
  },
];

const keyMetrics: MetricItem[] = [
  { label: "Market Cap", row: m("market_cap"), kind: "dollar" },
  { label: "P/E", row: m("trailing_pe"), kind: "multiple" },
  { label: "Price / Book", row: m("price_to_book"), kind: "multiple" },
  { label: "Dividend Yield", row: m("dividend_yield"), kind: "pct" },
  { label: "Revenue Growth · 3Y", row: m("revenue_growth_3y_cagr"), kind: "pct" },
  { label: "Operating Margin", row: m("operating_margin"), kind: "pct" },
  { label: "ROE", row: m("roe"), kind: "pct" },
  { label: "Debt / Equity", row: m("debt_to_equity"), kind: "multiple" },
];

const financialOverviewMetrics: MetricItem[] = [
  { label: "Revenue Growth · YoY", row: m("revenue_growth_yoy"), kind: "pct" },
  { label: "Gross Margin", row: m("gross_margin"), kind: "pct" },
  { label: "Operating Margin", row: m("operating_margin"), kind: "pct" },
  { label: "Net Margin", row: m("net_margin"), kind: "pct" },
  { label: "Free Cash Flow", row: m("fcf"), kind: "dollar" },
  { label: "Free Cash Flow Margin", row: m("fcf_margin"), kind: "pct" },
  { label: "Return on Invested Capital", row: m("roic"), kind: "pct" },
  { label: "Net Debt / EBITDA", row: m("net_debt_ebitda"), kind: "multiple" },
  { label: "Share Dilution · YoY", row: m("share_dilution_trend"), kind: "pct" },
];

// SEC's own standardized 8-K item codes (doc 21/24 Phase 1) -- a small,
// curated map, not exhaustive, same "curated not fuzzy" discipline as
// ai_query/aliases.py. Unmapped codes fall back to showing the raw code.
const ITEM_LABELS: Record<string, string> = {
  "1.01": "Material Agreement",
  "1.02": "Termination of Material Agreement",
  "2.01": "Completion of Acquisition/Disposition",
  "2.02": "Earnings Results",
  "2.03": "Direct Financial Obligation",
  "3.01": "Delisting/Non-Compliance Notice",
  "3.02": "Unregistered Equity Sale",
  "3.03": "Rights of Security Holders Modified",
  "5.01": "Change in Control",
  "5.02": "Officer/Director Change",
  "5.03": "Bylaw/Charter Amendment",
  "5.07": "Shareholder Vote",
  "5.08": "Shareholder Director Nominations",
  "7.01": "Reg FD Disclosure",
  "8.01": "Other Events",
  "9.01": "Financial Statements/Exhibits",
};

const sections = [
  { id: "overview", label: "Summary" },
  { id: "chart", label: "Chart" },
  { id: "analysis", label: "Analysis" },
  { id: "peers", label: "Peers" },
  { id: "financial-overview", label: "Financial Overview" },
  { id: "quarterly-results", label: "Quarterly Results" },
  { id: "profit-loss", label: "Income Statement" },
  { id: "balance-sheet", label: "Balance Sheet" },
  { id: "cash-flow", label: "Cash Flow" },
  { id: "ratios", label: "Ratios" },
  { id: "shareholding", label: "Shareholding" },
  { id: "documents", label: "Documents" },
];

const PERFORMANCE_LINE_PATTERN = /revenue|sales|operating income|operating profit|net income|net profit|diluted eps|earnings per share/i;
const performanceViews = [
  {
    id: "performance-quarterly",
    title: "Quarterly",
    purpose: "Latest eight reported quarters",
    data: { ...quarterlyResults, lines: quarterlyResults.lines.filter((line) => PERFORMANCE_LINE_PATTERN.test(line.label)) },
  },
  {
    id: "performance-annual",
    title: "Annual",
    purpose: "Latest five fiscal years",
    data: { ...incomeStatement, periods: incomeStatement.periods.slice(-5), lines: incomeStatement.lines.filter((line) => PERFORMANCE_LINE_PATTERN.test(line.label)).map((line) => ({ ...line, values: line.values.slice(-5) })) },
  },
];

const FORM_LABELS: Record<string, string> = {
  "10-K": "Annual report",
  "10-K/A": "Annual report amendment",
  "10-Q": "Quarterly report",
  "10-Q/A": "Quarterly report amendment",
  "8-K": "Current report",
  "8-K/A": "Current report amendment",
  "4": "Insider transaction",
  "SC 13D": "Active beneficial ownership",
  "SC 13G": "Passive beneficial ownership",
};

function secFilingUrl(accessionNumber: string): string {
  const cik = company.cik.replace(/^0+/, "") || "0";
  const accessionPath = accessionNumber.replaceAll("-", "");
  return `https://www.sec.gov/Archives/edgar/data/${cik}/${accessionPath}/${accessionNumber}-index.html`;
}

function filingSummary(form: string, items: string | null): string {
  if (items) {
    return items.split(",").map((item) => ITEM_LABELS[item.trim()] ?? item.trim()).join(" · ");
  }
  return FORM_LABELS[form] ?? `${form} filing`;
}

// Ownership section (insider_info.md) display rules, locked in
// doc/scoping/insider_info.md's 2026-08-29 display-rule addendum after
// doc/audit/2026-08-29_ownership_insider_data_audit.md: (1) the insider
// window summary's headline number is NET dollar value (buy - sell), not
// separate gross totals -- both gross figures still shown, but net leads;
// (2) the raw transaction list below it defaults to open-market P/S rows
// only, with an explicit toggle for grants/exercises/gifts/tax disposals,
// so routine compensation mechanics don't drown out the small minority of
// real conviction buys/sells.
const WINDOW_LABELS: Record<number, string> = { 3: "3 months", 6: "6 months", 12: "12 months" };
const insider12Month = insiderWindowSummary.find((window) => window.window_months === 12) ?? insiderWindowSummary.at(-1);
const institutionalOwnershipValue = institutionalSummary?.total_institutional_pct == null
  ? null
  : Number(institutionalSummary.total_institutional_pct);
const hasOwnershipMix = institutionalOwnershipValue !== null
  && Number.isFinite(institutionalOwnershipValue)
  && institutionalOwnershipValue >= 0
  && institutionalOwnershipValue <= 1;
const otherOwnershipValue = hasOwnershipMix ? 1 - institutionalOwnershipValue : null;

function netInsiderValue(w: { buy_dollar_volume: string; sell_dollar_volume: string }): number {
  return Number(w.buy_dollar_volume) - Number(w.sell_dollar_volume);
}

function fmtSignedDollar(n: number): string {
  const sign = n > 0 ? "+$" : n < 0 ? "-$" : "$";
  return sign + fmtNum(Math.abs(n).toString());
}

// Share counts, not dollar amounts -- reuses fmtShares' comma/M-suffix
// formatting instead of fmtNum's two-decimal dollar convention, so
// "share_change" columns read as share counts ("+770,720"), not as if
// they were currency ("+770720.00").
function fmtSignedShares(value: string): string {
  const n = Number(value);
  const sign = n > 0 ? "+" : n < 0 ? "-" : "";
  return sign + fmtShares(Math.abs(n).toString());
}

// Percentage-POINT change in an aggregate ownership % (e.g. 34.2% -> 32.9%
// is "-1.3pp") -- Overview strip and section-level QoQ/period stats only.
function fmtPctChange(value: string | null | undefined): string {
  if (value === null || value === undefined) return "—";
  const n = Number(value) * 100;
  return (n > 0 ? "+" : "") + n.toFixed(1) + "pp";
}

// Relative % change in ONE holder's own share count
// (institutional_summary.py/mutual_fund_summary.py's `pct_change` =
// share_change / prior_shares) -- a different quantity from the
// aggregate ownership-%-point change above, so it needs its own "%"
// suffix, not "pp", and can legitimately be large (a small prior
// position that grows several-fold shows e.g. "+753.9%", not a bug).
function fmtHolderPctChange(value: string | null | undefined): string {
  if (value === null || value === undefined) return "—";
  const n = Number(value) * 100;
  return (n > 0 ? "+" : "") + n.toFixed(1) + "%";
}

// doc 39 -- employeeHeadcountHistory holds at most the 2 most recent
// 10-Ks' disclosures (annual-only, confirmed no 10-Q repeats it), so
// this is a YoY comparison, not a true QoQ one despite reusing the
// Ownership section's "period-over-period" display language elsewhere
// on this page.
function fmtHeadcountChange(current: number, prior: number): string {
  const diff = current - prior;
  const pct = prior !== 0 ? (diff / prior) * 100 : 0;
  const sign = diff > 0 ? "+" : "";
  return `${sign}${diff.toLocaleString("en-US")} (${sign}${pct.toFixed(1)}%)`;
}

const OWNERSHIP_STATUS_LABELS: Record<string, string> = {
  new: "New",
  increased: "Increased",
  decreased: "Decreased",
  exited: "Exited",
  unchanged: "Unchanged",
};

function statusLabel(status: string): string {
  return OWNERSHIP_STATUS_LABELS[status] ?? status;
}

function statusClass(status: string): string {
  if (status === "new" || status === "increased") return "status-pill--positive";
  if (status === "exited" || status === "decreased") return "status-pill--negative";
  return "status-pill--neutral";
}

function directionLabel(value: string | null | undefined): string {
  if (value === null || value === undefined) return "No comparison available";
  const change = Number(value);
  if (change > 0) return "Ownership increased";
  if (change < 0) return "Ownership decreased";
  return "Ownership was unchanged";
}

interface RecentChange {
  label: string;
  value: string;
  detail: string;
  direction: "positive" | "negative" | "neutral";
}

const recentChanges: RecentChange[] = [];

function addRateChange(metricName: string, label: string) {
  const history = metricTrendHistory[metricName] ?? [];
  const current = history[0];
  const prior = history[1];
  if (!current || !prior || current.value === null || prior.value === null) return;
  const delta = (Number(current.value) - Number(prior.value)) * 100;
  recentChanges.push({
    label,
    value: `${delta > 0 ? "+" : ""}${delta.toFixed(1)}pp`,
    detail: `${fmtPct(current.value)} in ${current.period_end} vs ${fmtPct(prior.value)} in ${prior.period_end}`,
    direction: delta > 0 ? "positive" : delta < 0 ? "negative" : "neutral",
  });
}

addRateChange("operating_margin", "Operating margin");
addRateChange("revenue_growth_yoy", "Revenue-growth rate");

const dilution = m("share_dilution_trend");
if (dilution?.value !== null && dilution?.value !== undefined) {
  const value = Number(dilution.value);
  recentChanges.push({
    label: "Diluted share count",
    value: fmtPct(dilution.value),
    detail: `${value > 0 ? "Increased" : value < 0 ? "Decreased" : "Unchanged"} year over year · ${dilution.period_end}`,
    direction: value > 0 ? "negative" : value < 0 ? "positive" : "neutral",
  });
}

if (institutionalSummary?.qoq_change_pct !== null && institutionalSummary?.qoq_change_pct !== undefined) {
  const value = Number(institutionalSummary.qoq_change_pct);
  recentChanges.push({
    label: "Institutional ownership",
    value: fmtPctChange(institutionalSummary.qoq_change_pct),
    detail: `${directionLabel(institutionalSummary.qoq_change_pct)} · ${institutionalSummary.report_period_latest}`,
    direction: value > 0 ? "positive" : value < 0 ? "negative" : "neutral",
  });
}

if (employeeHeadcountHistory.length >= 2) {
  const current = employeeHeadcountHistory[0];
  const prior = employeeHeadcountHistory[1];
  recentChanges.push({
    label: "Reported workforce",
    value: fmtHeadcountChange(current.headcount, prior.headcount),
    detail: `${current.filing_date} vs ${prior.filing_date} · direction only, not inherently positive or negative`,
    direction: "neutral",
  });
}

const visibleRecentChanges = recentChanges.slice(0, 4);

const OPEN_MARKET_CODES = new Set(["P", "S"]);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={`Inspect ${company.company_name} (${company.ticker}) financial statements, ratios, ownership, and recent SEC filings with visible periods and sources.`} />
  <title>{company.company_name} ({company.ticker}) — Scrooner</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <PublicHeader
    screenerUrl={screenerUrl}
    current="company"
    companyHref={Astro.url.pathname}
    skipHref="#company-content"
    skipLabel="Skip to company research"
  />

  <main class="page-wrap" id="company-content">
  <nav class="section-nav" aria-label="Company page sections">
    {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
  </nav>

  <section class="summary-card" id="overview" aria-labelledby="company-name">
    <div class="summary-heading">
      <div class="summary-identity">
        <h1 id="company-name">{company.company_name}</h1>
        <p class="company-subline">
          <span>{company.ticker}</span>
          <span>·</span>
          <span title={company.sic_description ?? undefined}>{company.sector ?? "Sector unclassified"}</span>
          <span class={`status-badge${company.status !== "active" ? " inactive" : ""}`}>{company.status}</span>
          {company.website && <a class="identity-link" href={`https://${company.website}`} rel="nofollow noopener" target="_blank">Official website ↗</a>}
        </p>
      </div>
      <div class="price-block">
        {latestPrice ? (
          <>
            <span class="price-value" title={`${latestPrice.feed} feed, bar time ${latestPrice.bar_timestamp}`}>${Number(latestPrice.price).toFixed(2)}</span>
            <span class="price-freshness">Delayed · {new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date(latestPrice.bar_timestamp))} ET</span>
          </>
        ) : (
          <span class="price-value blocked" aria-label="Current price not available. No real price on record for this company.">— No price on record</span>
        )}
      </div>
    </div>

    <div class="summary-body">
      <aside class="company-profile company-profile--hero" aria-label="Company profile">
        <p class="profile-label">About</p>
        {cleanAboutText ? (
          <p class="profile-copy">{cleanAboutText}</p>
        ) : (
          <p class="profile-copy">{company.company_name} is {company.status === "active" ? "an active SEC registrant" : `an SEC registrant currently marked ${company.status}`} in the {company.sector ?? "unclassified"} sector ({company.sic_description ?? "no SIC classification on record"}). Scrooner converts its public filings into comparable financial statements, ratios, ownership records, and filing events.</p>
        )}
        {(employeeHeadcountHistory.length > 0 || segmentRevenue.length > 0) && (
          <div class="profile-context">
            <p class="profile-label">Business context</p>
            {employeeHeadcountHistory.length > 0 && <p><strong>{employeeHeadcountHistory[0].is_approximate ? "~" : ""}{employeeHeadcountHistory[0].headcount.toLocaleString("en-US")}</strong> reported employees</p>}
