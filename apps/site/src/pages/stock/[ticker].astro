---
// /stock/{ticker}/ -- "the crown jewel" (DOCUMENTATION.md sec 1, sec 3.2).
// Structure grounded in doc 17's real analysis of Screener.in's own page,
// then re-aligned with doc/design/10_Scrooner_Product_Design_Framework.md
// (Sec 8.4/12/13/14/17) once that framework existed. Reads Postgres
// directly (doc 04/17) -- no apps/backend dependency.
//
// Redesign notes (2026-08-19), so a future edit doesn't re-litigate why:
// - Design framework Sec 12.2 found this page rendering 39 metrics in two
//   flat, uncurated grids -- worse, 8 of the ORIGINAL doc 02 locked
//   metrics (gross/operating/net margin, current ratio, debt/equity,
//   interest coverage, fcf, fcf margin) were never wired in at all,
//   despite being computed since Mapper Stage 3d. Fixed here: all 45
//   metrics now render, split into a curated 8-item "Key metrics" set
//   (framework Sec 12.2's own recommended list, using this project's real
//   metric names) plus 7 named, always-visible categories (framework Sec
//   10.2's investor-language grouping) -- all shown at once by explicit
//   request, not collapsed behind a click.
// - Null states now carry an aria-label, not just a hover `title` --
//   framework Sec 17.2: "a dash must not be the only accessible label for
//   a missing value." See components/MetricGrid.astro.
// - Current Price moved into the company header (framework Sec 12.1's own
//   worked example puts price beside identity, not inside a metrics
//   grid); Book Value moved into the Valuation category.
// - Public visual tokens and shell now follow the homepage reference
//   direction and are shared through public-theme.css, PublicHeader, and
//   PublicFooter. The app domain keeps its workflow-specific shell.
import {
  getCompanyPageData,
  type MetricRow,
} from "../../lib/db";
import { buildChecklist } from "../../lib/prosCons";
import { fmtNum, fmtShares } from "../../lib/format";
import MetricGrid, { type MetricItem } from "../../components/MetricGrid.astro";
import PublicHeader from "../../components/PublicHeader.astro";
import PublicFooter from "../../components/PublicFooter.astro";
import "../../styles/public-theme.css";
import "../../styles/company-research.css";

const { ticker } = Astro.params;
const requestedTicker = ticker ?? "";
const dbStartedAt = performance.now();
const pageData = requestedTicker ? await getCompanyPageData(requestedTicker) : null;
const dbDurationMs = performance.now() - dbStartedAt;

if (!pageData) {
  return new Response("Company not found", { status: 404 });
}

const {
  company,
  metrics,
  quarterlyResults,
  incomeStatement,
  balanceSheet,
  cashFlow,
  filings,
  insiderTransactions,
  beneficialOwnership,
  institutionalHolders,
  publicFloat,
  latestPrice,
  bookValue,
  metricHistory,
} = pageData;

// Public company pages are identical for every visitor. Astro's Vercel cache
// provider serves a fresh response for 15 minutes, then may serve stale HTML
// while one background request refreshes it. Development mode intentionally
// disables the cache, which keeps local data iteration predictable.
if (Astro.cache.enabled) {
  Astro.cache.set({
    maxAge: 900,
    swr: 86400,
    tags: [`stock:${company.ticker?.toLowerCase() ?? requestedTicker.toLowerCase()}`],
  });
}

// This header appears on origin renders and makes the one-query contract
// observable without exposing SQL or connection details.
Astro.response.headers.set(
  "Server-Timing",
  `db;dur=${dbDurationMs.toFixed(1)};desc="company-page-read"`,
);
Astro.response.headers.set("X-Scrooner-DB-Queries", "1");

const availableMetricCount = Object.values(metrics).filter((row) => row.value !== null).length;
const trackedMetricCount = Object.keys(metrics).length;
const checklist = buildChecklist(metrics, metricHistory);
const strengths = checklist.filter((item) => item.kind === "pro");
const risks = checklist.filter((item) => item.kind === "con");
const appUrl = (import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
const screenerUrl = `${appUrl}/screener`;

function m(name: string): MetricRow | undefined {
  return metrics[name];
}

// Curated primary set -- design framework Sec 12.2's own recommended
// list (Market cap, P/E, Revenue growth, Operating margin, ROIC, FCF
// yield, Debt/equity, Share-count dilution/buyback trend), mapped to
// this project's real metric names. 3Y CAGR chosen over YoY for the
// headline growth figure -- less noisy period-to-period, same choice
// prosCons.ts already makes for its own revenue-growth rule.
const keyMetrics: MetricItem[] = [
  { label: "Market Cap", row: m("market_cap"), kind: "dollar" },
  { label: "Stock P/E", row: m("trailing_pe"), kind: "multiple" },
  { label: "Revenue Growth (3Y CAGR)", row: m("revenue_growth_3y_cagr"), kind: "pct" },
  { label: "Operating Margin", row: m("operating_margin"), kind: "pct" },
  { label: "ROIC", row: m("roic"), kind: "pct" },
  { label: "FCF Yield", row: m("fcf_yield"), kind: "pct" },
  { label: "Debt / Equity", row: m("debt_to_equity"), kind: "multiple" },
  { label: "Share Count Dilution (YoY)", row: m("share_dilution_trend"), kind: "pct" },
];

// All 45 metric_definition rows, none silently dropped -- grouped using
// the same investor-language categories the design framework's filter
// builder (Sec 10.2) uses, so the vocabulary matches across the whole
// product rather than this page inventing its own taxonomy.
const categories: { id: string; title: string; items: MetricItem[] }[] = [
  {
    id: "valuation",
    title: "Valuation",
    items: [
      { label: "Price / Sales", row: m("price_to_sales"), kind: "multiple" },
      { label: "Price / Book", row: m("price_to_book"), kind: "multiple" },
      { label: "Book Value (Equity)", kind: "raw", raw: bookValue ? "$" + fmtNum(bookValue) : undefined, nullReason: "No stockholders' equity fact resolved for this company" },
      { label: "Dividend Yield", row: m("dividend_yield"), kind: "pct" },
      { label: "PEG Ratio", row: m("peg_ratio"), kind: "multiple" },
      { label: "EV / EBITDA", row: m("ev_ebitda"), kind: "multiple" },
      { label: "EV / Sales", row: m("ev_sales"), kind: "multiple" },
    ],
  },
  {
    id: "growth",
    title: "Growth",
    items: [
      { label: "Revenue Growth (YoY)", row: m("revenue_growth_yoy"), kind: "pct" },
      { label: "Revenue Growth (5Y CAGR)", row: m("revenue_growth_5y_cagr"), kind: "pct" },
      { label: "Revenue Growth (10Y CAGR)", row: m("revenue_growth_10y_cagr"), kind: "pct" },
      { label: "EPS Growth (YoY)", row: m("eps_growth_yoy"), kind: "pct" },
      { label: "EPS Growth (3Y CAGR)", row: m("eps_growth_3y_cagr"), kind: "pct" },
      { label: "EPS Growth (5Y CAGR)", row: m("eps_growth_5y_cagr"), kind: "pct" },
      { label: "EPS Growth (10Y CAGR)", row: m("eps_growth_10y_cagr"), kind: "pct" },
    ],
  },
  {
    id: "profitability",
    title: "Profitability",
    items: [
      { label: "Gross Margin", row: m("gross_margin"), kind: "pct" },
      { label: "Net Margin", row: m("net_margin"), kind: "pct" },
      { label: "ROE", row: m("roe"), kind: "pct" },
      { label: "ROA", row: m("roa"), kind: "pct" },
      { label: "SBC % of Revenue", row: m("sbc_pct_revenue"), kind: "pct" },
    ],
  },
  {
    id: "cash-flow",
    title: "Cash Flow & Efficiency",
    items: [
      { label: "Free Cash Flow", row: m("fcf"), kind: "dollar" },
      { label: "FCF Margin", row: m("fcf_margin"), kind: "pct" },
      { label: "Cash Conversion Cycle", row: m("cash_conversion_cycle"), kind: "days" },
      { label: "Debtor Days", row: m("debtor_days"), kind: "days" },
      { label: "Inventory Days", row: m("inventory_days"), kind: "days" },
      { label: "Payables Days", row: m("payables_days"), kind: "days" },
    ],
  },
  {
    id: "financial-strength",
    title: "Financial Strength",
    items: [
      { label: "Current Ratio", row: m("current_ratio"), kind: "multiple" },
      { label: "Quick Ratio", row: m("quick_ratio"), kind: "multiple" },
      { label: "Interest Coverage", row: m("interest_coverage_ratio"), kind: "multiple" },
      { label: "EBITDA", row: m("ebitda"), kind: "dollar" },
      { label: "Net Debt / EBITDA", row: m("net_debt_ebitda"), kind: "multiple" },
      { label: "Debt-Free", row: m("zero_debt"), kind: "bool" },
      { label: "Piotroski F-Score", row: m("piotroski_f_score"), kind: "score" },
    ],
  },
  {
    id: "capital-allocation",
    title: "Capital Allocation & Quality",
    items: [
      { label: "Buyback Yield", row: m("buyback_yield"), kind: "pct" },
      { label: "Total Shareholder Yield", row: m("total_shareholder_yield"), kind: "pct" },
      { label: "FCF > Net Income", row: m("fcf_gt_net_income"), kind: "bool" },
      { label: "Profitable Streak", row: m("profitable_streak_years"), kind: "years" },
      { label: "Margin Expanding (3yr)", row: m("margin_expanding_3yr"), kind: "bool" },
    ],
  },
  {
    id: "ownership-metrics",
    title: "Ownership",
    items: [
      { label: "Institutional Ownership", row: m("institutional_ownership_pct"), kind: "pct" },
    ],
  },
];

// SEC's own standardized 8-K item codes (doc 21/24 Phase 1) -- a small,
// curated map, not exhaustive, same "curated not fuzzy" discipline as
// ai_query/aliases.py. Unmapped codes fall back to showing the raw code.
const ITEM_LABELS: Record<string, string> = {
  "1.01": "Material Agreement",
  "1.02": "Termination of Material Agreement",
  "2.01": "Completion of Acquisition/Disposition",
  "2.02": "Earnings Results",
  "2.03": "Direct Financial Obligation",
  "3.01": "Delisting/Non-Compliance Notice",
  "3.02": "Unregistered Equity Sale",
  "3.03": "Rights of Security Holders Modified",
  "5.01": "Change in Control",
  "5.02": "Officer/Director Change",
  "5.03": "Bylaw/Charter Amendment",
  "5.07": "Shareholder Vote",
  "5.08": "Shareholder Director Nominations",
  "7.01": "Reg FD Disclosure",
  "8.01": "Other Events",
  "9.01": "Financial Statements/Exhibits",
};

const sections = [
  { id: "overview", label: "Summary" },
  { id: "financials", label: "Financials" },
  { id: "analysis", label: "Strengths & Risks" },
  { id: "ownership", label: "Ownership" },
  { id: "filings", label: "Filings" },
  { id: "metrics", label: "All Metrics" },
];

const financialStatements = [
  { id: "quarterly", title: "Quarterly Results", data: quarterlyResults },
  { id: "profit-loss", title: "Profit & Loss", qualifier: "Annual", data: incomeStatement },
  { id: "balance-sheet", title: "Balance Sheet", qualifier: "Annual", data: balanceSheet },
  { id: "cash-flow", title: "Cash Flow", qualifier: "Annual", data: cashFlow },
];

const FORM_LABELS: Record<string, string> = {
  "10-K": "Annual report",
  "10-K/A": "Annual report amendment",
  "10-Q": "Quarterly report",
  "10-Q/A": "Quarterly report amendment",
  "8-K": "Current report",
  "8-K/A": "Current report amendment",
  "4": "Insider transaction",
  "SC 13D": "Active beneficial ownership",
  "SC 13G": "Passive beneficial ownership",
};

function secFilingUrl(accessionNumber: string): string {
  const cik = company.cik.replace(/^0+/, "") || "0";
  const accessionPath = accessionNumber.replaceAll("-", "");
  return `https://www.sec.gov/Archives/edgar/data/${cik}/${accessionPath}/${accessionNumber}-index.html`;
}

function filingSummary(form: string, items: string | null): string {
  if (items) {
    return items.split(",").map((item) => ITEM_LABELS[item.trim()] ?? item.trim()).join(" · ");
  }
  return FORM_LABELS[form] ?? `${form} filing`;
}
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={`Inspect ${company.company_name} (${company.ticker}) financial statements, ratios, ownership, and recent SEC filings with visible periods and sources.`} />
  <title>{company.company_name} ({company.ticker}) — Scrooner</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <PublicHeader
    screenerUrl={screenerUrl}
    current="company"
    companyHref={Astro.url.pathname}
    skipHref="#company-content"
    skipLabel="Skip to company research"
  />

  <main class="page-wrap" id="company-content">
    <nav class="section-nav" aria-label="Company page sections">
      {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </nav>

  <section class="summary-card" id="overview" aria-labelledby="company-name">
    <div class="summary-heading">
      <div>
        <div class="identity-price">
          <h1 id="company-name">{company.company_name}</h1>
          <div class="price-block">
            {latestPrice ? (
              <>
                <span class="price-value" title={`${latestPrice.feed} feed, bar time ${latestPrice.bar_timestamp}`}>${Number(latestPrice.price).toFixed(2)}</span>
                <span class="price-freshness">Delayed · {new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", hour: "2-digit", minute: "2-digit", hour12: false }).format(new Date(latestPrice.bar_timestamp))} ET</span>
              </>
            ) : (
              <span class="price-value blocked" aria-label="Current price not available. No real price on record for this company." title="No real price on record for this company">— No price on record</span>
            )}
          </div>
        </div>
        <p class="company-subline">
          <span>{company.ticker}</span>
          <span>·</span>
          <span title={company.sic_description ?? undefined}>{company.sector ?? "Sector unclassified"}</span>
          <span class={`status-badge${company.status !== "active" ? " inactive" : ""}`}>{company.status}</span>
        </p>
      </div>
    </div>

    <div class="summary-body">
      <div>
        <MetricGrid items={keyMetrics} compact />
        <p class="note summary-metrics-note">Each available value shows its filing period. Unavailable values retain a traceable reason.</p>
        {publicFloat && (
          <p class="note"><strong>Public Float</strong> · {fmtNum(publicFloat.value)} as of {publicFloat.period_end} (10-K cover-page value, not market cap).</p>
        )}
      </div>

      <aside class="company-profile" aria-label="Company profile">
        <p class="profile-label">About</p>
        <p class="profile-copy">{company.company_name} is {company.status === "active" ? "an active SEC registrant" : `an SEC registrant currently marked ${company.status}`} in the {company.sector ?? "unclassified"} sector ({company.sic_description ?? "no SIC classification on record"}). Scrooner converts its public filings into comparable financial statements, ratios, ownership records, and filing events.</p>
        <ul class="profile-facts">
          <li><strong>CIK</strong> {company.cik}</li>
          <li><strong>Metric coverage</strong> {availableMetricCount} of {trackedMetricCount} currently available</li>
          <li><strong>Primary source</strong> SEC EDGAR filings</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="page-section" id="financials">
    <h2>Financials</h2>
    <p class="note section-intro-note">Review quarterly performance and annual statements without losing the latest period while scrolling.</p>
    <div class="statement-card" data-statement-tabs>
      <div class="statement-toolbar">
        <div class="statement-tabs" role="tablist" aria-label="Financial statement">
          {financialStatements.map((statement, index) => (
            <button
              class="statement-tab"
              id={`statement-tab-${statement.id}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`statement-panel-${statement.id}`}
              tabindex={index === 0 ? 0 : -1}
            >
              {statement.title}
            </button>
          ))}
        </div>
        <span class="statement-unit">USD · values auto-scaled</span>
      </div>
      {financialStatements.map((statement) => (
        <section
          class="statement-panel"
          id={`statement-panel-${statement.id}`}
          role="tabpanel"
          aria-labelledby={`statement-tab-${statement.id}`}
          data-statement-panel
        >
          <div class="statement-panel-heading">
            <h3>{statement.title}{statement.qualifier && <span class="statement-qualifier">{statement.qualifier}</span>}</h3>
            <span class="scroll-cue" aria-hidden="true">Earlier periods ← scroll → Latest</span>
          </div>
          {statement.data.periods.length > 0 && statement.data.lines.length > 0 ? (
            <div class="statement-scroll" tabindex="0" role="group" aria-label={`${statement.title}, scroll horizontally for earlier periods`}>
              <table class="financial-table">
                <caption class="sr-only">{statement.title} for {company.company_name}, most recent periods last.</caption>
                <thead>
                  <tr>
                    <th scope="col"><span class="sr-only">Line item</span></th>
                    {statement.data.periods.slice(-8).map((p, i, arr) => <th scope="col" class={i === arr.length - 1 ? "hl" : undefined}>{p.fiscal_period} {p.fiscal_year}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {statement.data.lines.map((line) => (
                    <tr>
                      <th scope="row">{line.label}</th>
                      {line.values.slice(-8).map((v, i, arr) => <td class={i === arr.length - 1 ? "hl" : undefined}>{fmtNum(v)}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="data-empty">No comparable {statement.title.toLowerCase()} periods are available for this company yet.</p>
          )}
        </section>
      ))}
    </div>
  </section>

  <section class="page-section" id="analysis">
    <h2>Strengths &amp; Risks</h2>
    <div class="card">
      <div class="analysis-grid">
        <div class="analysis-panel strengths">
          <p class="analysis-title">Strengths</p>
          {strengths.length > 0 ? (
            <ul class="analysis-list">{strengths.map((item) => <li>{item.text}</li>)}</ul>
          ) : (
            <p class="analysis-empty">No current strength rule was triggered.</p>
          )}
        </div>
        <div class="analysis-panel risks">
          <p class="analysis-title">Risks</p>
          {risks.length > 0 ? (
            <ul class="analysis-list">{risks.map((item) => <li>{item.text}</li>)}</ul>
          ) : (
            <p class="analysis-empty">No current risk rule was triggered.</p>
          )}
        </div>
      </div>
      <p class="note">Fixed, published checklist rules against verified metrics—not an AI opinion or investment recommendation.</p>
    </div>
  </section>

  <section class="page-section" id="ownership">
    <h2>Ownership</h2>

    <div class="card">
      <h3>Insider Activity</h3>
      <div class="statement-scroll" tabindex="0" role="group" aria-label="Insider activity, scroll horizontally for all columns">
        <table class="insider-table">
          <caption class="sr-only">Form 4 insider transactions for {company.company_name}.</caption>
          <thead>
            <tr>
              <th scope="col">Insider</th><th scope="col">Title</th><th scope="col">Date</th><th scope="col">Type</th><th scope="col">Shares</th><th scope="col">Price</th><th scope="col">Owned After</th><th scope="col">Plan</th><th scope="col">Source</th>
            </tr>
          </thead>
          <tbody>
            {insiderTransactions.map((t) => (
              <tr>
                <td>{t.reporting_owner_name}</td>
                <td>{t.officer_title ?? (t.is_director ? "Director" : t.is_ten_percent_owner ? "10%+ Owner" : "—")}</td>
                <td>{t.transaction_date}</td>
                <td>{t.acquired_disposed_code === "A" ? "Buy" : t.acquired_disposed_code === "D" ? "Sell" : t.transaction_code}</td>
                <td>{fmtShares(t.shares)}</td>
                <td>{t.price_per_share ? "$" + Number(t.price_per_share).toFixed(2) : "—"}</td>
                <td>{fmtShares(t.shares_owned_following)}</td>
                <td title={t.is_10b5_1_plan === null ? "Filed before the 2023-04-01 Rule 10b5-1(c) disclosure requirement" : t.is_10b5_1_plan ? "Pre-arranged Rule 10b5-1(c) trading plan" : "Discretionary transaction, not a disclosed 10b5-1 plan"}>
                  {t.is_10b5_1_plan === null ? "—" : t.is_10b5_1_plan ? "10b5-1" : "Discretionary"}
                </td>
                <td><a class="source-link" href={secFilingUrl(t.accession_number)} target="_blank" rel="noreferrer">SEC filing <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></td>
              </tr>
            ))}
            {insiderTransactions.length === 0 && <tr><td colspan="9"><em>No Form 4 activity on record.</em></td></tr>}
          </tbody>
        </table>
      </div>
      <p class="note">Every open-market buy/sell/tax-withholding transaction disclosed by officers, directors, and 10%+ owners on Form 4, traced to its own accession number. "Plan" distinguishes a pre-arranged Rule 10b5-1(c) trading plan from a discretionary transaction (SEC disclosure required since 2023-04-01; "—" means the filing predates that requirement, not that no plan exists).</p>
    </div>

    <div class="card">
      <h3>Institutional Ownership</h3>
      <div class="statement-scroll" tabindex="0" role="group" aria-label="Institutional holders, scroll horizontally for all columns">
        <table>
          <caption class="sr-only">Institutional holders of {company.company_name} reported on Form 13F.</caption>
          <thead>
            <tr><th scope="col">Manager</th><th scope="col">Shares</th><th scope="col">Value</th><th scope="col">As of</th></tr>
          </thead>
          <tbody>
            {institutionalHolders.map((h) => (
              <tr>
                <td>{h.filer_name}</td>
                <td>{fmtShares(h.shares)}</td>
                <td>{h.value_usd ? "$" + fmtNum(h.value_usd) : "—"}</td>
                <td>{h.filing_date}</td>
              </tr>
            ))}
            {institutionalHolders.length === 0 && <tr><td colspan="4"><em>No Form 13F holdings on record.</em></td></tr>}
          </tbody>
        </table>
      </div>
      <p class="note">The largest reported holders from SEC's bulk Form 13F institutional-manager data set, matched by CUSIP (not filed by {company.ticker} itself) — a single recent filing window, not a historical trend.</p>
    </div>

    <div class="card">
      <h3>Major Shareholders (&gt;5% stakes)</h3>
      <div class="statement-scroll" tabindex="0" role="group" aria-label="Major shareholders, scroll horizontally for all columns">
        <table>
          <caption class="sr-only">Schedule 13D/13G filers for {company.company_name}.</caption>
          <thead>
            <tr><th scope="col">Filer</th><th scope="col">Schedule</th><th scope="col">Date</th><th scope="col">Source</th></tr>
          </thead>
          <tbody>
            {beneficialOwnership.map((o) => (
              <tr>
                <td>{o.filer_name}</td>
                <td>{o.schedule_type}{o.is_amendment ? "/A" : ""}</td>
                <td>{o.filing_date}</td>
                <td><a class="source-link" href={secFilingUrl(o.accession_number)} target="_blank" rel="noreferrer">SEC filing <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></td>
              </tr>
            ))}
            {beneficialOwnership.length === 0 && <tr><td colspan="4"><em>No Schedule 13D/13G disclosures on record.</em></td></tr>}
          </tbody>
        </table>
      </div>
      <p class="note">Schedule 13D (activist intent) / 13G (passive) disclosures where {company.ticker} is confirmed as the actual subject company, not the filer. Ownership percentage/share count aren't extracted yet (free-text, not yet parsed); filer identity and filing date are.</p>
    </div>
  </section>

  <section class="page-section" id="filings">
    <h2>Recent Filings</h2>
    <div class="card">
      <div class="filing-list">
        {filings.length > 0 ? (
          filings.map((f) => (
            <article class="filing-row">
              <div>
                <div class="filing-title">
                  <span class="form-badge">{f.form}</span>
                  <strong>{filingSummary(f.form, f.items)}</strong>
                </div>
                <p class="filing-meta">Filed {f.filing_date} · {f.accession_number}</p>
              </div>
              <a class="source-link" href={secFilingUrl(f.accession_number)} target="_blank" rel="noreferrer">View SEC filing <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            </article>
          ))
        ) : (
          <p class="data-empty data-empty--flush">No recent SEC filings are available for this company yet.</p>
        )}
      </div>
      <p class="note">Event labels for 8-K filings use the SEC's own structured item classification. Accession numbers remain visible as audit metadata rather than primary content.</p>
    </div>
  </section>

  <section class="page-section" id="metrics">
    <h2>All Metrics</h2>
    <p class="note section-intro-note section-intro-note--spaced">The complete metric catalogue is available by category after the primary research flow.</p>
    {categories.map((category) => (
      <details class="category" id={category.id}>
        <summary>
          <span class="category-title">{category.title}</span>
          <span class="category-count">{category.items.length} metrics</span>
        </summary>
        <div class="category-body">
          <MetricGrid items={category.items} dense />
        </div>
      </details>
    ))}
  </section>
  </main>

  <PublicFooter screenerUrl={screenerUrl} companyHref={Astro.url.pathname} />

  <script>
    for (const group of document.querySelectorAll<HTMLElement>("[data-statement-tabs]")) {
      const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>("[role='tab']"));
      const panels = Array.from(group.querySelectorAll<HTMLElement>("[data-statement-panel]"));

      function activate(index: number, moveFocus = false) {
        tabs.forEach((tab, tabIndex) => {
          const active = tabIndex === index;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[tabIndex].hidden = !active;
        });
        if (moveFocus) tabs[index].focus();
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(index));
        tab.addEventListener("keydown", (event) => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft") next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          activate(next, true);
        });
      });

      activate(0);
    }
  </script>
</body>
</html>
