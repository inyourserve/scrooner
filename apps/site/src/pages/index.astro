---
// Public product entrance. Visual direction supplied by the user in
// homepage.html: calm cool-gray canvas, compact navigation, oversized
// lowercase identity, one centered company-search task, and restrained teal.
// Demo-only links and fake account actions from that reference are deliberately
// excluded. Every company option below resolves to a real public research page.
import { getCompaniesByTickers } from "../lib/db";
import PublicHeader from "../components/PublicHeader.astro";
import PublicFooter from "../components/PublicFooter.astro";
import BrandMark from "../components/BrandMark.astro";
import CompanySearch from "../components/CompanySearch.astro";
import "../styles/public-theme.css";
import "../styles/home.css";

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
const screenerUrl = `${appUrl}/screener`;
const preferredNames: Record<string, string> = {
  AAPL: "Apple",
  MSFT: "Microsoft",
  NVDA: "Nvidia",
  AMZN: "Amazon",
  GOOGL: "Alphabet",
  "BRK.B": "Berkshire",
  COST: "Costco",
  V: "Visa",
  JPM: "JPMorgan",
  LLY: "Eli Lilly",
  KO: "Coca-Cola",
};
const preferredTickers = Object.keys(preferredNames);
const companies = await getCompaniesByTickers(preferredTickers);
const byTicker = new Map(companies.map((company) => [company.ticker.toUpperCase(), company]));
const preferredCompanies = preferredTickers.flatMap((ticker) => {
  const company = byTicker.get(ticker);
  return company ? [{ ...company, display_name: preferredNames[ticker] }] : [];
});
const quickPicks = preferredCompanies.slice(0, 8);
const companyResearchHref = quickPicks[0] ? `/stock/${quickPicks[0].ticker.toLowerCase()}/` : "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Screen US companies in plain English and inspect SEC-derived company financials, ratios, ownership, and filings."
    />
    <title>Scrooner — Verifiable US company research</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <PublicHeader
      screenerUrl={screenerUrl}
      current="home"
      companyHref="#company-search"
      skipHref="#main-content"
      skipLabel="Skip to company search"
    />

    <main class="home-main" id="main-content">
      <div class="hero-wordmark" aria-label="Scrooner">
        <span class="name">scrooner</span>
        <BrandMark size="large" class="hero-research-mark" />
      </div>

      <h1 class="tagline">Screen US companies in plain English—with results you can verify.</h1>
      <p class="subtag">Explore SEC-derived financials, ratios, ownership, and filings for every company in Scrooner's covered universe.</p>

      <div id="company-search">
        <CompanySearch id="home-company-query" variant="hero" />
      </div>

      {quickPicks.length > 0 && (
        <div class="quick-picks" aria-label="Popular company pages">
          <span class="label">Or analyse:</span>
          {quickPicks.map((company) => (
            <a class="ds-chip company-chip" href={`/stock/${company.ticker.toLowerCase()}/`}>
              {company.display_name}
              <span class="ticker">{company.ticker}</span>
            </a>
          ))}
        </div>
      )}

      <p class="screener-path">Have an investment thesis? <a href={screenerUrl}>Build a fundamental screen →</a></p>
    </main>

    <PublicFooter screenerUrl={screenerUrl} companyHref={companyResearchHref} />
  </body>
</html>
