---
import PublicPageLayout from "../components/PublicPageLayout.astro";
export const prerender = true;
const appUrl = (import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000").replace(/\/$/, "");
---
<PublicPageLayout current="pricing" eyebrow="Current access" title="Scrooner is in beta" description="The product is evolving and access may change as coverage, reliability, and research workflows mature.">
  <section class="public-callout">
    <h2>Use the current beta</h2>
    <p>No paid plans or prices are being announced on this page today. You can open the available product experience and evaluate the current coverage directly.</p>
    <p><a class="ds-button ds-button--primary" href={`${appUrl}/screener`}>Open screener</a></p>
  </section>
  <section>
    <h2>What beta means</h2>
    <p>Features, limits, company coverage, and availability can change. If paid plans are introduced, this page will describe them clearly before they apply.</p>
  </section>
</PublicPageLayout>
