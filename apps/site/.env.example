# Postgres connection string -- Astro reads core/analytics directly, with no
# apps/backend dependency (doc 04/17). Use Supabase's transaction pooler
# (port 6543) for Vercel/serverless. A persistent local Node process may use
# the session pooler on port 5432. db.ts disables prepared statements so both
# modes are supported.
DATABASE_URL=postgresql://user:password@host:6543/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SEC EDGAR fair-access User-Agent (doc 07), only needed if this app ever
# calls SEC directly -- currently unused, kept for parity with pipeline/.
SEC_USER_AGENT="Your Name your-email@example.com"

# Public origin of the Next.js screener app (apps/app), used for the
# homepage's real screener/screen links. Default matches apps/app's own
# local dev port.
PUBLIC_APP_URL=http://localhost:3000
