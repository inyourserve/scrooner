DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8100
DJANGO_HSTS_SECONDS=3600

# Django-owned auth/session tables. Local development defaults to SQLite.
ADMIN_DATABASE_URL=postgresql://ops_writer:password@pooler-host:5432/postgres

# Read-only role with SELECT grants only on allow-listed operational data.
WAREHOUSE_DATABASE_URL=postgresql://ops_reader:password@pooler-host:5432/postgres

# Dedicated bearer credential for machine workers. Never expose to Next.js.
OPS_WORKER_TOKEN=replace-with-a-long-random-worker-token
OPS_WORKER_LEASE_SECONDS=900
