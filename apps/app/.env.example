# Server-only URL for apps/backend. Browser requests go through Next route handlers.
SCROONER_BACKEND_URL=http://127.0.0.1:8000

# Optional. Caches the company page's single consolidated query
# (lib/company/cache.ts) -- shared across every server instance, unlike
# Next's own per-process unstable_cache. Absent/unreachable Redis fails
# open (falls straight through to Postgres, same contract as
# apps/backend/cache.py) -- never required for the app to run.
# Local dev: `brew install redis && brew services start redis`.
# Production: a real hosted Redis URL (Upstash recommended, matching
# doc/adr/0001-screener-redis-cache-and-boolean-logic.md).
REDIS_URL=redis://localhost:6379/0

# Canonical public origin used for auth callbacks and absolute links.

# Supabase Auth is intentionally inactive until both public values are set.
# Copy these from the Supabase project Connect dialog. A publishable key is
# designed for browser use; never put SUPABASE_SERVICE_ROLE_KEY in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical Next.js application origin. This is used to validate redirect-back
# destinations and prevent an authentication open redirect.
NEXT_PUBLIC_SCROONER_URL=http://localhost:3000

# Leave empty for localhost. In production the locked cross-subdomain policy is
# `.scrooner.com`, so Supabase's HttpOnly session cookies can be read by both
# Use `.scrooner.com` only if cookies must span apex and legacy redirect hosts.
SUPABASE_AUTH_COOKIE_DOMAIN=
