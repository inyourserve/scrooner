{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "display-certificate/1",
  "title": "Scrooner display certificate (written by pipeline/scripts/certify_display.py)",
  "description": "One certificate per certified coverage file. cells holds EVERY cell of the file. evidence: drawn = individually matched to the filing (counts toward the bound); census = every total_debt year and every hidden cell's hide proof; sampled = covered by the bound, never present as individually verified. Approver rulings: data-team/strategy/approvals/CERT-REGISTRY-rulings-2026-11-21.md. Money and counts are decimal strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ticker", "company_id", "verdict", "coverage_path", "coverage_sha256", "sample_hash", "seed",
               "detector_version", "resolver", "code_sha", "method", "approver", "certified_at", "counts", "bound", "gate", "cells"],
  "properties": {
    "schema": {"const": "display-certificate/1"},
    "ticker": {"type": "string", "minLength": 1},
    "company_id": {"type": ["integer", "null"], "description": "From the request file; null only for a run without --request."},
    "verdict": {"enum": ["PASS", "FAIL", "REVIEW"], "description": "Load only PASS into analytics.display_cell_certificate."},
    "coverage_path": {"type": "string"},
    "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Equals coverage_sha256: the certificate's identity."},
    "seed": {"type": "string", "description": "<TICKER>-<first 12 hex of coverage_sha256>; fixes the draw."},
    "detector_version": {"type": ["string", "null"], "description": "Request line 'proof DETECTOR_VERSION'."},
    "resolver": {"type": ["string", "null"], "description": "Request line 'resolver' (repo path)."},
    "code_sha": {"type": ["string", "null"], "description": "Request line 'code'."},
    "method": {"type": "string"},
    "approver": {"type": "string", "minLength": 1},
    "certified_at": {"type": "string", "description": "ISO date of the run."},
    "counts": {"type": "object", "additionalProperties": {"type": "integer"}},
    "bound": {
      "type": "object", "additionalProperties": false, "required": ["n", "errors", "upper_95"],
      "properties": {
        "n": {"type": "integer", "description": "Drawn cells."},
        "errors": {"type": "integer"},
        "upper_95": {"type": "string", "description": "Exact Clopper-Pearson one-sided 95% upper bound, decimal string."},
        "target_upper_95": {"type": "string", "description": "The bound the draw size is chosen for (0.015000); absent on certificates before 2026-11-22."},
        "required_n": {"type": "integer", "description": "ceil(ln(0.05)/ln(1-target)) = 199: the draw size giving the target at 0 errors."},
        "rule": {"type": "string", "description": "The draw-size rule as applied: min(required_n, shown cells)."},
        "pool": {"type": "integer", "description": "Shown cells the draw could pick (every shown cell except the total_debt census)."},
        "census": {"type": "boolean", "description": "true when n equals the pool: every shown cell was drawn."},
        "strata": {
          "type": "array", "description": "Stratified draw: statement x badge class (as_printed / combined / derived).",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["statement", "badge_class", "cells", "drawn"],
            "properties": {
              "statement": {"type": "string"},
              "badge_class": {"enum": ["as_printed", "combined", "derived"]},
              "cells": {"type": "integer"},
              "drawn": {"type": "integer"}
            }
          }
        }
      }
    },
    "draw_check": {
      "type": "object", "required": ["checker", "ran"],
      "description": "Automated draw checker (certification/draw_check.py, since 2026-11-22): each drawn cell against the cited filing's own XBRL facts, and who verified it: the machine (AUTO_MATCH) or a person/agent filing read (NEEDS_READ, AUTO_MISMATCH). Absent on older certificates.",
      "properties": {
        "checker": {"type": "string"}, "ran": {"type": "boolean"}, "drawn": {"type": "integer"},
        "auto_matched": {"type": "integer"}, "auto_mismatched": {"type": "integer"}, "needs_read": {"type": "integer"},
        "verified_by_machine": {"type": "integer"}, "verified_by_read": {"type": "integer"}, "pending_read": {"type": "integer"},
        "read_cells": {"type": "array", "items": {"type": "object", "required": ["data_point", "fiscal_year", "machine", "reader", "verdict", "evidence"]}},
        "audit": {"type": ["object", "null"], "description": "draw_check.audit_agreement: agent reads of a seeded 5% of AUTO_MATCH cells."}
      }
    },
    "gate": {"type": "array", "items": {"type": "object", "required": ["data_point", "fiscal_year", "severity", "detail"]}},
    "cells": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["data_point", "fiscal_year", "period_end", "grain", "display", "hide_class", "reason_code", "shown_value",
                     "accession", "r_page", "tag", "parts", "evidence", "result", "detail"],
        "properties": {
          "data_point": {"type": "string"},
          "fiscal_year": {"type": "string"},
          "period_end": {"type": "string"},
          "grain": {"enum": ["FY", "I"], "description": "analytics.cell_display_state grain: I instant, FY annual duration."},
          "display": {"enum": ["SHOWN_VALUE", "HIDDEN_ROW", "HIDDEN_YEAR", "OPEN"]},
          "hide_class": {"type": ["string", "null"]},
          "reason_code": {"type": ["string", "null"]},
          "shown_value": {"type": ["string", "null"]},
          "accession": {"type": ["string", "null"]},
          "r_page": {"type": ["string", "null"]},
          "tag": {"type": ["string", "null"]},
          "parts": {"type": "array", "items": {"type": "object", "required": ["tag", "dims", "value", "sign", "accession", "r_page"]}},
          "evidence": {"enum": ["drawn", "census", "sampled"]},
          "result": {"enum": ["MATCH", "MISMATCH", "NOT_FOUND", "LOCATOR", "REVIEW", "SAMPLED"]},
          "detail": {"type": "string"},
          "auto_check": {"type": "object", "required": ["outcome", "method", "filing_value", "detail"],
                         "properties": {"outcome": {"enum": ["AUTO_MATCH", "AUTO_MISMATCH", "NEEDS_READ"]}, "method": {"type": "string"},
                                        "filing_value": {"type": ["string", "null"]}, "detail": {"type": "string"}}},
          "verified_by": {"type": "string", "pattern": "^(machine|pending_read|read:.+)$",
                          "description": "Drawn cells only: machine (AUTO_MATCH), read:<reader> (a person or agent read the filing), or pending_read."}
        }
      }
    }
  }
}
