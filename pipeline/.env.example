# Copy to .env and fill in. Never commit .env.
# Use the Supabase connection POOLER (aws-0-<region>.pooler.supabase.com), not
# the direct db.<ref>.supabase.co host -- found 2026-08-14 that the direct
# host's DNS record can go unresolvable while the project is otherwise
# healthy, and the pooler is also more robust for a long-lived connection
# held across a multi-minute bulk download. See doc/learnings/day-04-retry-and-resume.md.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use a real, reachable contact email. Switch to a scrooner.com address once that's live.
SEC_USER_AGENT=Scrooner your-email@example.com

# Market-price vendor (doc 02's previously-open decision -- resolved 2026-08-17,
# see doc 02). Alpaca Markets API keys, paper/live per Alpaca's own account setup.
ALPACA_API_KEY=
ALPACA_API_SECRET=