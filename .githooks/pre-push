#!/usr/bin/env bash
# Pre-push gate (added 2026-10-21): keep `main` green for the CI advisory job.
#
# Several sessions push to main every few minutes. Between 2026-10-18 and 2026-10-21 the
# CI "Advisory formatting, typing, and dependency audits" job was red almost permanently
# because new commits kept landing unformatted or with type errors faster than anyone could
# fix them. This hook runs the same two checks CI runs, on the exact commit being pushed
# (in a throwaway checkout, so another session's uncommitted edits cannot cause false
# failures), and blocks a push to main that would turn them red. Takes a few seconds.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Fix formatting:          uvx ruff format pipeline/src apps/backend
# Check types:             uvx mypy --ignore-missing-imports --follow-imports=skip --explicit-package-bases pipeline/src apps/backend
# Emergency bypass (founder only, say why in the commit message): git push --no-verify
set -u
zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue   # deleting a ref
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/prepush.XXXXXX")"
  if ! git worktree add -q --detach "$tmp/wt" "$local_sha" >/dev/null 2>&1; then
    echo "pre-push: could not check out $local_sha for checking; allowing the push" >&2
    rm -rf "$tmp"; continue
  fi
  (
    cd "$tmp/wt" || exit 0
    fail=0
    if ! out="$(uvx ruff format --check pipeline/src apps/backend 2>&1)"; then
      echo "pre-push: BLOCKED. Ruff formatting check failed:" >&2
      echo "$out" | tail -3 >&2
      echo "  fix: uvx ruff format pipeline/src apps/backend   (then amend or add a commit)" >&2
      fail=1
    fi
    if ! out="$(uvx mypy --ignore-missing-imports --follow-imports=skip --explicit-package-bases pipeline/src apps/backend 2>&1)"; then
      echo "pre-push: BLOCKED. mypy reported errors (same command as CI):" >&2
      echo "$out" | grep -E "error:|Found" | head -12 >&2
      fail=1
    fi
    exit "$fail"
  ) || status=1
  git worktree remove --force "$tmp/wt" >/dev/null 2>&1
  rm -rf "$tmp"
done
exit "$status"
